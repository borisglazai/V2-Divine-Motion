{
  "name": "divine-motion-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "wrangler types && astro check",
    "lint": "eslint .",
    "test": "node --test tests/routes.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seeds/local.sql",
    "db:test:invariants": "node --test tests/db/invariants.test.mjs",
    "db:test:dal": "node --import tsx --test tests/dal/dal.test.ts",
    "db:test": "npm run db:test:invariants && npm run db:test:dal",
    "test:auth": "node --import tsx --test tests/auth/access.test.ts",
    "test:admin": "node --test tests/admin/routes.test.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "wrangler": "^4.131.2"
  }
}
