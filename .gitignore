# build output
dist/
.astro/

# dependencies
node_modules/

# environment
.env
.env.production

# editors / OS
.DS_Store

# wrangler
.wrangler/
# local-only secrets (R2 S3 API credentials, Brief 014) — never committed,
# read by `wrangler dev`/`astro dev` the same way `wrangler secret` values
# are read at runtime. See .dev.vars.example for the expected keys and
# docs/DEPLOYMENT.md "R2 credentials" for staging/production (wrangler
# secret put, never a file).
.dev.vars
.dev.vars.*
!.dev.vars.example
# isolated local D1 persistence directories used only by the test suites
# (tests/db/invariants.test.mjs, tests/dal/dal.test.ts) — never the
# developer's seeded local DB in .wrangler/.
.wrangler-test/
.wrangler-test-dal/
.wrangler-test-migration-0003-fresh/
.wrangler-test-migration-0003-upgrade/
.wrangler-test-public-media/
.wrangler-test-public-workview/
.wrangler-test-public-servicesview/
# generated by `wrangler types` (run automatically by `npm run typecheck`)
# — declares the `cloudflare:workers` module and the `Env`/`D1Database`
# ambient types from wrangler.toml. Regenerated, never hand-edited; same
# treatment as .astro/types.d.ts.
worker-configuration.d.ts
