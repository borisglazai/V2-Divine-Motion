---
/**
 * Read-only media picker (Implementation Brief 013 §12/§29/§30) — no
 * upload, built on the existing `listMedia()` DAL read. Callers filter
 * the list to `processing_status === 'ready'` before passing it in (see
 * src/pages/admin/work/new.astro / [id].astro), so this component never
 * needs to know about upload lifecycle states itself.
 *
 * Validation Brief 014S bug fix: thumbnails now render the real object via
 * `/admin/media/:id/file` (the same admin-only, Access-gated R2 read route
 * `/admin/media` itself uses — see src/pages/admin/media/[id]/file.ts and
 * src/pages/admin/media/index.astro) instead of a hardcoded mock
 * placeholder. That placeholder predates Brief 014's real R2 upload
 * pipeline (ADR-005/ADR-006 were still open when this component was
 * written) and was never updated once real media existed — every card
 * rendered the same static SVG path regardless of which media was
 * selected, which is what showed up as a broken image on staging (the
 * exact preview mechanism was never swapped, not a broken URL
 * computation). This never exposes the R2 bucket directly — same
 * server-side proxy read as the Médiathèque, never a public bucket URL.
 */
import type { MediaRow } from "@/lib/db/types";
import ImageFrame from "@/components/ImageFrame.astro";
import { mediaFileUrl } from "@/lib/admin/media-preview";

interface Props {
  media: MediaRow[];
  selectedId?: number | null;
  error?: string;
}

const { media, selectedId = null, error } = Astro.props;
---

<fieldset class="media-picker">
  <legend>Média</legend>
  {error && (
    <p class="media-picker__error" id="mediaId-error" role="alert">
      {error}
    </p>
  )}
  <div class="media-picker__list" role="radiogroup" aria-describedby={error ? "mediaId-error" : undefined}>
    {
      media.map((item) => (
        <label class:list={["media-picker__item", { "is-selected": item.id === selectedId }]}>
          <input type="radio" name="mediaId" value={item.id} checked={item.id === selectedId} required />
          <ImageFrame
            src={mediaFileUrl(item.id)}
            alt={item.alt_fr ?? item.original_filename ?? ""}
            ratio="1 / 1"
            focalX={item.focal_x}
            focalY={item.focal_y}
            class="media-picker__thumb"
          />
          <span class="media-picker__meta">
            <span class="media-picker__filename">{item.original_filename ?? item.storage_key}</span>
            <span class="media-picker__dims">
              {item.width && item.height ? `${item.width} × ${item.height}` : "Dimensions inconnues"}
            </span>
            {item.publication_rights_confirmed === 1 ? (
              <span class="media-picker__rights-badge media-picker__rights-badge--confirmed">Droits confirmés</span>
            ) : (
              <span class="media-picker__rights-badge">Droits non confirmés — publication bloquée</span>
            )}
          </span>
        </label>
      ))
    }
    {media.length === 0 && <p class="media-picker__empty">Aucun média disponible (prêt, non supprimé).</p>}
  </div>
</fieldset>

<style>
  .media-picker {
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .media-picker legend {
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding-inline: var(--space-2);
  }

  .media-picker__error {
    color: #e08a80;
    font-size: var(--text-small);
    margin-bottom: var(--space-2);
  }

  .media-picker__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: var(--space-3);
    max-height: 22rem;
    overflow-y: auto;
  }

  .media-picker__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .media-picker__item.is-selected {
    border-color: var(--color-accent-warm);
    background: color-mix(in srgb, var(--color-accent-warm) 8%, transparent);
  }

  .media-picker__item input {
    align-self: flex-start;
  }

  .media-picker__thumb {
    width: 100%;
  }

  .media-picker__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .media-picker__filename {
    font-size: var(--text-small);
    color: var(--color-text-primary);
    word-break: break-all;
  }

  .media-picker__dims {
    font-size: var(--text-micro);
    color: var(--color-text-secondary);
  }

  /* Not-confirmed is the default (matches media/[id].astro's
     .media-form__rights-status convention) — the confirmed variant below
     overrides it. Same colors as that page, so "confirmed" always means
     the same thing everywhere in the admin. */
  .media-picker__rights-badge {
    font-size: var(--text-micro);
    color: #e08a80;
  }

  .media-picker__rights-badge--confirmed {
    color: var(--color-accent-warm);
  }

  .media-picker__empty {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }
</style>
