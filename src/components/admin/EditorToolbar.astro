---
/**
 * Éditeur visuel Phase 1 — the persistent "chrome" Boris's brief requires
 * ("toolbar d'édition persistante, navigation entre pages, édition inline
 * et remplacement d'images directement dans leur emplacement"). Rendered
 * once per page through BaseLayout's `admin-chrome` named slot (see
 * HomeView.astro/ServicesView.astro), never inlined into the public
 * components themselves — this is page CHROME, not page CONTENT, so it
 * stays a sibling of the real page rather than something Editable.astro/
 * EditableImage.astro need to know about.
 *
 * Three responsibilities, none of which duplicate any public rendering
 * logic:
 *   1. Page navigation + FR/EN toggle — plain links, computed from the
 *      current request URL, so leaving this component never breaks edit
 *      mode (it's just a normal navigation to another /admin/site/** URL).
 *   2. Save/Publish/Aperçu/language-status actions — plain <form>s
 *      (Enregistrer submits the SAME <form id="cms-editor-form"> that
 *      BaseLayout wraps around <main> — see its `editorFormAction` prop —
 *      via the HTML `form` button attribute, so this component never
 *      needs to be an ancestor of the fields it saves).
 *   3. The one shared media picker <dialog> + the one script that syncs
 *      contenteditable/image-picker state into the save form right
 *      before submit — written once here rather than per editable field.
 */
import type { Locale } from "@/i18n/routes";
import type { MediaRow, WorkGalleryLayout } from "@/lib/db/types";
import { mediaFileUrl } from "@/lib/admin/media-preview";
import { GALLERY_LAYOUTS } from "@/lib/work-gallery-layouts";

export type SiteEditorPageId = "home" | "services" | "travail" | "about" | "contact";
export type SiteEditorMode = "edit" | "preview";
export type SiteEditorLanguageStatus = "draft" | "published";

interface Props {
  activePageId: SiteEditorPageId;
  locale: Locale;
  mode: SiteEditorMode;
  /** False for the 2 pages not yet wired this phase (À propos/Contact) — nav + quit still work, nothing else does. */
  available: boolean;
  publishAction?: string;
  languageStatusAction?: string;
  hasDraft?: boolean;
  frStatus?: SiteEditorLanguageStatus;
  enStatus?: SiteEditorLanguageStatus;
  /** Only passed when available && mode === "edit" — the ready media the picker dialog lists. */
  media?: MediaRow[];
  /**
   * Éditeur visuel Phase 2, Travail only — the current `work_page_content.
   * gallery_layout`. Boris's brief §6: "une composition doit être
   * représentée visuellement avant sélection" — rendered as 3 visual
   * cards (not a bare <select>), submitted as part of the same
   * #cms-editor-form as title/intro/cta (via the `form` attribute, same
   * trick the toolbar's own Enregistrer button already uses).
   */
  galleryLayout?: WorkGalleryLayout;
}

const {
  activePageId,
  locale,
  mode,
  available,
  publishAction,
  languageStatusAction,
  hasDraft = false,
  frStatus,
  enStatus,
  media,
  galleryLayout,
} = Astro.props;

const PAGES: { id: SiteEditorPageId; label: string; href: string; available: boolean }[] = [
  { id: "home", label: "Accueil", href: "/admin/site", available: true },
  { id: "services", label: "Services", href: "/admin/site/services", available: true },
  { id: "travail", label: "Travail", href: "/admin/site/travail", available: true },
  { id: "about", label: "À propos", href: "/admin/site/a-propos", available: true },
  { id: "contact", label: "Contact", href: "/admin/site/contact", available: true },
];

function withParams(pathname: string, overrides: Record<string, string | undefined>): string {
  const url = new URL(pathname, "https://placeholder.local");
  for (const [key, value] of Object.entries(overrides)) {
    if (value === undefined) url.searchParams.delete(key);
    else url.searchParams.set(key, value);
  }
  return url.pathname + (url.search ? url.search : "");
}

const currentPath = Astro.url.pathname;
const previewHref = withParams(currentPath, { lang: locale, mode: "preview" });
const editHref = withParams(currentPath, { lang: locale, mode: undefined });
---

<div class="cms-toolbar" data-cms-toolbar>
  <span class="cms-toolbar__label">
    Mode édition{mode === "preview" && " — Aperçu"}
  </span>

  {/*
    Éditeur visuel Phase 2 — mobile toolbar fix (Boris's staging feedback:
    "toolbar trop haute"). Desktop is unaffected (hidden via CSS,
    min-width: 768px); on mobile this collapses everything below into a
    scrollable panel, shown only once tapped, so the always-visible bar
    stays a single compact row instead of wrapping into several.
  */}
  <button type="button" class="cms-toolbar__toggle" data-cms-toolbar-toggle aria-expanded="false" aria-controls="cms-toolbar-body">
    Menu
  </button>

  <div class="cms-toolbar__body" id="cms-toolbar-body">
  <nav class="cms-toolbar__pages" aria-label="Pages du site">
    {
      PAGES.map((page) => (
        <a
          href={withParams(page.href, { lang: locale })}
          aria-current={page.id === activePageId ? "page" : undefined}
          class:list={[
            "cms-toolbar__page-link",
            { "cms-toolbar__page-link--active": page.id === activePageId },
          ]}
        >
          {page.label}
          {!page.available && <span class="cms-toolbar__soon"> (bientôt)</span>}
        </a>
      ))
    }
  </nav>

  <div class="cms-toolbar__lang" role="group" aria-label="Langue">
    <a href={withParams(currentPath, { lang: "fr", mode: mode === "preview" ? "preview" : undefined })} aria-current={locale === "fr" ? "true" : undefined}>
      FR
    </a>
    <a href={withParams(currentPath, { lang: "en", mode: mode === "preview" ? "preview" : undefined })} aria-current={locale === "en" ? "true" : undefined}>
      EN
    </a>
  </div>

  {
    available && mode === "edit" && (
      <div class="cms-toolbar__actions">
        <button type="submit" form="cms-editor-form" class="cms-toolbar__primary">
          Enregistrer
        </button>
        <a href={previewHref} class="cms-toolbar__ghost">
          Aperçu
        </a>
        {hasDraft && publishAction && (
          <form method="POST" action={publishAction} class="cms-toolbar__inline-form">
            <button type="submit" class="cms-toolbar__ghost">
              Publier
            </button>
          </form>
        )}
      </div>
    )
  }

  {
    available && mode === "preview" && (
      <div class="cms-toolbar__actions">
        <a href={editHref} class="cms-toolbar__ghost">
          Retour à l'édition
        </a>
      </div>
    )
  }

  {
    available && languageStatusAction && (
      <div class="cms-toolbar__lang-status">
        <form method="POST" action={languageStatusAction} class="cms-toolbar__inline-form">
          <input type="hidden" name="locale" value="fr" />
          <input type="hidden" name="status" value={frStatus === "published" ? "draft" : "published"} />
          <button type="submit" class="cms-toolbar__ghost cms-toolbar__ghost--small">
            {frStatus === "published" ? "Dépublier FR" : "Publier FR"}
          </button>
        </form>
        <form method="POST" action={languageStatusAction} class="cms-toolbar__inline-form">
          <input type="hidden" name="locale" value="en" />
          <input type="hidden" name="status" value={enStatus === "published" ? "draft" : "published"} />
          <button type="submit" class="cms-toolbar__ghost cms-toolbar__ghost--small">
            {enStatus === "published" ? "Dépublier EN" : "Publier EN"}
          </button>
        </form>
      </div>
    )
  }

  <a href="/admin" class="cms-toolbar__quit">Quitter le mode édition</a>
  </div>
</div>

{
  activePageId === "travail" && available && mode === "edit" && galleryLayout && (
    <div class="cms-layout-picker" role="radiogroup" aria-label="Composition de la galerie Travail">
      {Object.values(GALLERY_LAYOUTS).map((layout) => (
        <label class:list={["cms-layout-picker__option", { "cms-layout-picker__option--active": layout.id === galleryLayout }]}>
          <input type="radio" name="galleryLayout" value={layout.id} checked={layout.id === galleryLayout} form="cms-editor-form" />
          <span class="cms-layout-picker__label">{layout.label}</span>
          <span class="cms-layout-picker__description">{layout.description}</span>
        </label>
      ))}
    </div>
  )
}

{
  available && mode === "edit" && media && (
    <dialog id="cms-media-picker" class="cms-media-picker">
      <div class="cms-media-picker__header">
        <p>Choisir une image</p>
        <button type="button" class="cms-media-picker__close" data-cms-close-media-picker aria-label="Fermer">
          ✕
        </button>
      </div>
      <div class="cms-media-picker__grid">
        {media.map((item) => (
          <button
            type="button"
            class="cms-media-picker__item"
            data-cms-media-option
            data-media-id={item.id}
            data-media-src={mediaFileUrl(item.id)}
          >
            <img src={mediaFileUrl(item.id)} alt="" loading="lazy" />
            {item.publication_rights_confirmed !== 1 && (
              <span class="cms-media-picker__badge">Droits non confirmés</span>
            )}
          </button>
        ))}
      </div>
    </dialog>
  )
}

<script>
  // Éditeur visuel Phase 2 — mobile toolbar collapse toggle. Desktop never
  // sees this button (hidden via CSS), so this listener is harmless there.
  const toolbarToggle = document.querySelector<HTMLButtonElement>("[data-cms-toolbar-toggle]");
  const toolbarBody = document.getElementById("cms-toolbar-body");
  toolbarToggle?.addEventListener("click", () => {
    const expanded = toolbarToggle.getAttribute("aria-expanded") === "true";
    toolbarToggle.setAttribute("aria-expanded", String(!expanded));
    toolbarBody?.classList.toggle("cms-toolbar__body--expanded", !expanded);
  });
</script>

<script>
  // Éditeur visuel Phase 1/2 — the one place that turns the shared, mostly-
  // declarative Editable/EditableImage markup into an actual save request.
  // Never talks to D1 directly; only ever populates a plain <form> that a
  // server POST endpoint already knows how to read as ordinary form
  // fields. Phase 1 only ever had one such form (BaseLayout.astro's
  // #cms-editor-form); Phase 2's per-slot Travail editing
  // (GallerySlot.astro) adds more, each its own <form data-cms-form> — so
  // this wires EVERY `[data-cms-form]` on the page the same way, scoping
  // the field sync to that specific form (never `document`-wide) so
  // sibling slot forms never clobber each other on submit.
  function hiddenInput(form: HTMLFormElement, name: string): HTMLInputElement {
    let input = form.querySelector<HTMLInputElement>(`input[type="hidden"][name="${CSS.escape(name)}"]`);
    if (!input) {
      input = document.createElement("input");
      input.type = "hidden";
      input.name = name;
      form.appendChild(input);
    }
    return input;
  }

  document.querySelectorAll<HTMLFormElement>("form[data-cms-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      form.querySelectorAll<HTMLElement>("[data-cms-field]").forEach((el) => {
        const field = el.dataset.cmsField;
        if (!field) return;
        hiddenInput(form, field).value = el.textContent?.trim() ?? "";
      });
      form.querySelectorAll<HTMLElement>("[data-cms-media-field]").forEach((el) => {
        const field = el.dataset.cmsMediaField;
        if (!field) return;
        hiddenInput(form, field).value = el.dataset.cmsMediaId ?? "";
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-cms-field]").forEach((el) => {
    el.addEventListener("input", () => {
      el.setAttribute("data-cms-dirty", "true");
    });
  });

  // Éditeur visuel Phase 2 — Travail gallery-layout picker (staging bug:
  // clicking Story/Minimal correctly checked the underlying radio — see
  // `form="cms-editor-form"` on each <input> — and Enregistrer + reload
  // DID persist it, but `.cms-layout-picker__option--active` was only
  // ever computed server-side from the page's initial `galleryLayout`
  // prop, so nothing ever visually reflected the click before a reload.
  // The native radio group already handles selection itself (mouse,
  // keyboard, touch alike) — this only keeps the VISUAL state in sync
  // with it, via the radio's own `change` event.
  function syncLayoutPickerActiveClass(): void {
    document.querySelectorAll<HTMLElement>(".cms-layout-picker__option").forEach((label) => {
      const input = label.querySelector<HTMLInputElement>('input[name="galleryLayout"]');
      label.classList.toggle("cms-layout-picker__option--active", !!input?.checked);
    });
  }
  document.querySelectorAll<HTMLInputElement>('input[name="galleryLayout"]').forEach((input) => {
    input.addEventListener("change", syncLayoutPickerActiveClass);
  });

  const dialog = document.getElementById("cms-media-picker") as HTMLDialogElement | null;
  // Éditeur visuel Phase 2 — tracks the actual wrapper ELEMENT the trigger
  // belongs to (found once, at click time, via the nearest ancestor
  // `[data-cms-media-field]`), not a bare field-name string looked up
  // globally afterwards. Phase 1 only ever had one image field per page,
  // so a global `document.querySelector` by field name was unambiguous;
  // Phase 2's per-slot Travail gallery (GallerySlot.astro) can have many
  // "mediaId" fields on the same page, one per slot form — this makes the
  // shared dialog correctly target the ONE slot that opened it regardless
  // of how many other forms reuse the same field name.
  let targetWrapper: HTMLElement | null = null;

  document.querySelectorAll<HTMLElement>("[data-cms-open-media-picker]").forEach((btn) => {
    btn.addEventListener("click", () => {
      targetWrapper = btn.closest<HTMLElement>("[data-cms-media-field]");
      dialog?.showModal();
    });
  });

  dialog?.querySelector("[data-cms-close-media-picker]")?.addEventListener("click", () => {
    dialog.close();
  });

  dialog?.querySelectorAll<HTMLElement>("[data-cms-media-option]").forEach((option) => {
    option.addEventListener("click", () => {
      if (!targetWrapper || !dialog) return;
      const mediaId = option.dataset.mediaId;
      const mediaSrc = option.dataset.mediaSrc;
      if (mediaId && mediaSrc) {
        targetWrapper.dataset.cmsMediaId = mediaId;
        targetWrapper.setAttribute("data-cms-dirty", "true");
        const img = targetWrapper.querySelector("img");
        if (img) img.src = mediaSrc;
      }
      dialog.close();
    });
  });
</script>

<style>
  .cms-toolbar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 999;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    background: rgba(20, 18, 16, 0.92);
    backdrop-filter: blur(8px);
    color: #f2ede6;
    font-family: var(--font-sans);
    font-size: var(--text-small);
  }

  .cms-toolbar__label {
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Mobile-only collapse toggle — desktop never renders it. */
  .cms-toolbar__toggle {
    display: none;
    margin-inline-start: auto;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    background: transparent;
    color: #f2ede6;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-3);
    min-height: 2rem;
    cursor: pointer;
  }

  .cms-toolbar__body {
    display: contents;
  }

  @media (max-width: 767px) {
    /*
     * Éditeur visuel Phase 2 — mobile toolbar fix (Boris's staging
     * feedback: "toolbar trop haute" / "boutons surdimensionnés"). The
     * always-visible bar collapses to one compact row (label + toggle);
     * everything else moves into a scrollable panel shown only once
     * tapped, and every control inside shrinks — never a full redesign,
     * same components/classes, just smaller and hidden-by-default here.
     */
    .cms-toolbar {
      padding-block: var(--space-2);
      gap: var(--space-2);
    }

    .cms-toolbar__toggle {
      display: inline-flex;
    }

    .cms-toolbar__body {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: var(--space-3);
      max-height: 60vh;
      overflow-y: auto;
      padding-top: var(--space-2);
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .cms-toolbar__body--expanded {
      display: flex;
    }

    .cms-toolbar__actions,
    .cms-toolbar__lang-status {
      margin-inline-start: 0;
    }

    .cms-toolbar__primary,
    .cms-toolbar__ghost {
      min-height: 2.25rem;
      padding: var(--space-1) var(--space-3);
      font-size: 0.85em;
    }
  }

  .cms-toolbar__pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cms-toolbar__page-link {
    color: rgba(242, 237, 230, 0.7);
    text-decoration: none;
    padding-block: var(--space-1);
    border-bottom: 1px solid transparent;
  }

  .cms-toolbar__page-link:hover,
  .cms-toolbar__page-link:focus-visible {
    color: #fff;
  }

  .cms-toolbar__page-link--active {
    color: #fff;
    border-bottom-color: var(--color-accent-warm);
  }

  .cms-toolbar__soon {
    opacity: 0.6;
    font-size: 0.85em;
  }

  .cms-toolbar__lang {
    display: flex;
    gap: var(--space-2);
  }

  .cms-toolbar__lang a {
    color: rgba(242, 237, 230, 0.7);
    text-decoration: none;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .cms-toolbar__lang a[aria-current="true"] {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .cms-toolbar__actions,
  .cms-toolbar__lang-status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .cms-toolbar__inline-form {
    display: inline-block;
  }

  .cms-toolbar__primary,
  .cms-toolbar__ghost {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    cursor: pointer;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    min-height: 2.5rem;
  }

  .cms-toolbar__primary {
    background: var(--color-accent-warm);
    color: #1a1512;
    border: none;
    font-weight: 600;
  }

  .cms-toolbar__ghost {
    background: transparent;
    color: #f2ede6;
    border: 1px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .cms-toolbar__ghost--small {
    font-size: 0.8em;
    padding: var(--space-1) var(--space-3);
    min-height: 2rem;
  }

  .cms-toolbar__ghost:hover,
  .cms-toolbar__ghost:focus-visible,
  .cms-toolbar__primary:hover,
  .cms-toolbar__primary:focus-visible {
    opacity: 0.85;
  }

  .cms-toolbar__quit {
    color: rgba(242, 237, 230, 0.6);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .cms-toolbar__quit:hover,
  .cms-toolbar__quit:focus-visible {
    color: #fff;
  }

  /* LAYOUT PICKER (Travail — Phase 2) — sits above the toolbar bar itself,
     fixed to the bottom like the toolbar, so it's always visible without
     scrolling past the gallery. Visual cards, never a bare <select> — see
     Boris's brief §6. */
  .cms-layout-picker {
    position: fixed;
    inset-inline: 0;
    bottom: 3.75rem;
    z-index: 998;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    background: rgba(20, 18, 16, 0.92);
    backdrop-filter: blur(8px);
  }

  .cms-layout-picker__option {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 10rem;
    max-width: 16rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-sm);
    cursor: pointer;
    color: rgba(242, 237, 230, 0.75);
  }

  .cms-layout-picker__option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cms-layout-picker__option:hover,
  .cms-layout-picker__option:focus-within {
    border-color: rgba(255, 255, 255, 0.5);
  }

  .cms-layout-picker__option--active {
    border-color: var(--color-accent-warm);
    color: #fff;
  }

  .cms-layout-picker__label {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-small);
  }

  .cms-layout-picker__description {
    font-size: 0.75rem;
    opacity: 0.8;
  }

  @media (max-width: 767px) {
    .cms-layout-picker {
      position: static;
      bottom: auto;
      /* Bug found while mobile-smoke-testing this fix: in normal flow the
         picker's own content could still end up sitting directly above
         the toolbar's collapsed fixed bar with no gap, so its bottom
         option was partially covered and untappable at that exact
         viewport height. Reserve the same space BaseLayout.astro already
         reserves for the collapsed toolbar (`#cms-editor-form`'s mobile
         `padding-bottom: 3.5rem`), so nothing here ever sits under it. */
      margin-bottom: 3.5rem;
    }
  }

  /* MEDIA PICKER DIALOG */
  .cms-media-picker {
    width: min(48rem, 92vw);
    max-height: 80vh;
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    color: var(--color-text-primary);
  }

  .cms-media-picker::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .cms-media-picker__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .cms-media-picker__header p {
    font-family: var(--font-serif);
    margin: 0;
  }

  .cms-media-picker__close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: var(--text-body);
    color: var(--color-text-secondary);
  }

  .cms-media-picker__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8rem, 1fr));
    gap: var(--space-3);
    padding: var(--space-6);
    overflow-y: auto;
    max-height: calc(80vh - 4rem);
  }

  .cms-media-picker__item {
    position: relative;
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: none;
    aspect-ratio: 1;
  }

  .cms-media-picker__item:hover,
  .cms-media-picker__item:focus-visible {
    border-color: var(--color-accent-warm);
  }

  .cms-media-picker__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cms-media-picker__badge {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    background: rgba(20, 18, 16, 0.8);
    color: #f2ede6;
    font-size: 0.65rem;
    padding: 2px var(--space-2);
  }
</style>
