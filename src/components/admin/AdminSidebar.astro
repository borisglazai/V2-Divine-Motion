---
import { ADMIN_NAV_ITEMS, type AdminPageId } from "@/lib/admin/nav";
import AdminNavItem from "./AdminNavItem.astro";

interface Props {
  activeId: AdminPageId;
}

const { activeId } = Astro.props;
---

<nav class="admin-sidebar" aria-label="Navigation admin">
  <a class="admin-sidebar__wordmark" href="/admin">Divine Motion</a>
  <ul class="admin-sidebar__list">
    {ADMIN_NAV_ITEMS.map((item) => <AdminNavItem item={item} active={item.id === activeId} />)}
  </ul>
</nav>

<style>
  .admin-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .admin-sidebar {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      height: 100vh;
      width: 15rem;
      flex-shrink: 0;
      background: var(--color-surface-admin);
      border-right: var(--border-width) solid var(--color-border);
      padding-block: var(--space-6) var(--space-4);
      overflow-y: auto;
    }
  }

  .admin-sidebar__wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-text-primary);
    text-decoration: none;
    padding-inline: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .admin-sidebar__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
</style>
