---
/**
 * Éditeur visuel Phase 2/4 — renders one AdminGallerySlot (from
 * src/lib/work-gallery-adapter.ts's buildAdminGallerySlots) per
 * composition slot, each containing its GallerySlot.astro entries (one
 * per image the slot's shape expects).
 *
 * Phase 4 (Boris's audit §5, validated with guardrails): the geometry
 * (margins/widths/flex-splits per breakpoint) now comes from
 * `GalleryBlockFrame.astro` — the SAME component WorkGallery.astro uses
 * for the public page — instead of this file's own approximate
 * `.travail-gallery-editor__block--*` CSS. `reveal` is deliberately never
 * passed here (unlike WorkGallery.astro): an admin editing their gallery
 * needs every slot visible immediately, not faded in on scroll.
 * GallerySlot.astro itself is untouched — only what wraps it changed.
 */
import type { Locale } from "@/i18n/routes";
import type { AdminGallerySlot } from "@/lib/work-gallery-adapter";
import type { AdminGalleryItemMeta } from "@/lib/db/work";
import type { GallerySlotShape } from "@/lib/work-gallery-layouts";
import type { GalleryBlockShape } from "@/lib/gallery-blocks";
import GallerySlot from "@/components/admin/GallerySlot.astro";
import GalleryBlockFrame from "@/components/GalleryBlockFrame.astro";

interface Props {
  slots: AdminGallerySlot[];
  meta: Map<number, AdminGalleryItemMeta>;
  locale: Locale;
  redirectTo: string;
}

const { slots, meta, locale, redirectTo } = Astro.props;

/** `GallerySlotShape` (discriminant `block`) -> `GalleryBlockShape` (discriminant `type`) — see gallery-blocks.ts's doc comment for why the public-facing name is the one both sides map onto. */
function toBlockShape(shape: GallerySlotShape): GalleryBlockShape {
  if (shape.block === "offset") return { type: "offset", side: shape.side };
  if (shape.block === "duo") return { type: "duo", split: shape.split };
  return { type: shape.block };
}

/**
 * Éditeur visuel Phase 3 — Précédent/Suivant (Boris's brief §5) needs to
 * know which occupied, published-backed entries sit at either end of the
 * reorderable sequence so GallerySlot.astro never renders a dead-end
 * control. This is exactly the flattened, in-order id list
 * src/lib/admin/work-slot-actions.ts's moveWorkSlotAction itself computes
 * server-side (same filter: skip empty slots and brand-new never-published
 * items) — kept in sync by construction since both read from the same
 * `items`/`meta` the page already fetched via
 * work.listWorkItemsForAdminGallery.
 */
const reorderableIds = slots.flatMap((slot) => slot.entries).flatMap((entry) => (entry.item && !meta.get(entry.item.id)?.isNewDraft ? [entry.item.id] : []));
const firstReorderableId = reorderableIds[0];
const lastReorderableId = reorderableIds[reorderableIds.length - 1];
---

<div class="travail-gallery-editor">
  {
    slots.map((slot) => {
      const entries = slot.entries;
      const slotProps = (entry: (typeof entries)[number]) => ({
        entry,
        meta: entry.item ? (meta.get(entry.item.id) ?? null) : null,
        locale,
        redirectTo,
        isFirstReorderable: entry.item?.id === firstReorderableId,
        isLastReorderable: entry.item?.id === lastReorderableId,
      });
      return (
        <GalleryBlockFrame shape={toBlockShape(slot.shape)}>
          <Fragment slot="item-0">
            <GallerySlot {...slotProps(entries[0])} />
          </Fragment>
          {entries[1] && (
            <Fragment slot="item-1">
              <GallerySlot {...slotProps(entries[1])} />
            </Fragment>
          )}
          {entries[2] && (
            <Fragment slot="item-2">
              <GallerySlot {...slotProps(entries[2])} />
            </Fragment>
          )}
        </GalleryBlockFrame>
      );
    })
  }
</div>

<style>
  .travail-gallery-editor {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
</style>
