---
/**
 * Éditeur visuel Phase 2/3 — the "template-driven editorial gallery
 * builder" Boris's brief centers on: one slot of the chosen composition
 * (src/lib/work-gallery-layouts.ts), rendered admin-side in EXACTLY the
 * shape it'll have publicly (same ratio/orientation), with direct
 * in-place editing.
 *
 * Phase 3 redesign (Boris's brief: "trop de champs toujours visibles ...
 * un slot doit ressembler à une vraie zone de composition, pas à un
 * formulaire"). Compact by default:
 *
 *  - OCCUPIED (entry.item set): the image (EditableImage — its own
 *    full-surface hover/tap overlay already IS the "Changer l'image"
 *    quick action, unchanged from Phase 2) + one low-key meta row
 *    (ratio, publication state / "Masqué"). A single always-visible but
 *    unobtrusive toolstrip carries the frequent actions — "Modifier"
 *    (expands the compact panel below, same collapse pattern as
 *    EditorToolbar.astro's mobile menu: full HTML always present,
 *    server-rendered, one class toggle), "Précédent"/"Suivant" (Boris's
 *    brief §5 — validated: NOT drag-and-drop) and "Retirer"/"Remettre"
 *    (§4 — validated: `is_visible` toggle, draft-only, never touches R2
 *    or deletes the row). Kept as a persistent small row rather than a
 *    true hover-only reveal so keyboard and touch users get the exact
 *    same access as a mouse hover would — hover-gated controls would
 *    either be unreachable without a pointer or need a second "tap to
 *    reveal" step Boris's §12 (mobile) explicitly wants to avoid.
 *    Alt FR/EN, caption FR/EN, the focal point, and per-language publish
 *    (§7) all move into that collapsible panel — advanced fields, not
 *    permanently visible.
 *  - EMPTY (entry.item null): keeps its expected ratio/orientation
 *    visible (e.g. "16:9 — Paysage") with an "Ajouter une photo" action.
 *    Alt/caption fields are hidden until a media is actually picked
 *    (§3 — "jamais de champ alt avant sélection de l'image"); once
 *    picked, alt FR/EN pre-fills from the chosen media's own alt when it
 *    has one (EditorToolbar.astro's picker, client-side only, never
 *    invented — §11, validated: creation-time only).
 *
 * Never reachable by a public visitor: only rendered from
 * src/pages/admin/site/travail.astro (via WorkView.astro's `editable`
 * branch), itself behind src/middleware.ts's Cloudflare Access gate —
 * same trust boundary as every other src/components/admin/** component.
 */
import type { Locale } from "@/i18n/routes";
import type { AdminSlotEntry } from "@/lib/work-gallery-adapter";
import type { AdminGalleryItemMeta } from "@/lib/db/work";
import { mediaFileUrl } from "@/lib/admin/media-preview";
import EditableImage from "@/components/admin/EditableImage.astro";
import Editable from "@/components/admin/Editable.astro";

interface Props {
  entry: AdminSlotEntry;
  meta: AdminGalleryItemMeta | null;
  locale: Locale;
  redirectTo: string;
  /**
   * Éditeur visuel Phase 3 — Précédent/Suivant (Boris's brief §5): whether
   * this occupied, published-backed item sits at either end of the
   * reorderable sequence (src/lib/admin/work-slot-actions.ts's
   * moveWorkSlotAction), so the editor never renders a dead-end control.
   * Always false for an empty slot or a brand-new never-published item
   * (neither is reorderable).
   */
  isFirstReorderable?: boolean;
  isLastReorderable?: boolean;
}

const { entry, meta, locale, redirectTo, isFirstReorderable = false, isLastReorderable = false } = Astro.props;
const ratioStyle = `aspect-ratio: ${entry.expectedShape.ratio.replace("/", " / ")};`;

/** Éditeur visuel Phase 3 (Boris's brief §6) — one plain-language publication state, readable without opening /admin/work. */
function statusLabel(): string {
  if (meta?.isNewDraft) return "Brouillon (jamais publié)";
  const frPublished = meta?.frStatus === "published";
  const enPublished = meta?.enStatus === "published";
  if (frPublished && enPublished) return "Publié FR + EN";
  if (frPublished) return "Publié FR";
  if (enPublished) return "Publié EN";
  return "Brouillon";
}

const isVisible = entry.item ? entry.item.is_visible === 1 : true;
const canReorder = entry.item !== null && !meta?.isNewDraft;
---

{
  entry.item ? (
    <div class="gallery-slot gallery-slot--occupied" data-gallery-slot>
      <form method="POST" action="/admin/site/travail/slot/save" data-cms-form class="gallery-slot__media-form">
        <input type="hidden" name="workItemId" value={entry.item.id} />
        <input type="hidden" name="redirect" value={redirectTo} />
        <input type="hidden" name="focalX" value={entry.item.focal_x} data-gallery-slot-focal-input="x" />
        <input type="hidden" name="focalY" value={entry.item.focal_y} data-gallery-slot-focal-input="y" />

        <div class="gallery-slot__preview">
          <EditableImage
            field="mediaId"
            src={mediaFileUrl(entry.item.media_id)}
            alt=""
            mediaId={entry.item.media_id}
            ratio={entry.expectedShape.ratio}
            focalX={entry.item.focal_x}
            focalY={entry.item.focal_y}
            editable
          />
        </div>

        <div class="gallery-slot__meta-row">
          <span class="gallery-slot__ratio-tag">{entry.expectedShape.ratioLabel}</span>
          <span
            class:list={[
              "gallery-slot__status-tag",
              "admin-badge",
              { "gallery-slot__status-tag--hidden": !isVisible, "admin-badge--warn": !isVisible },
            ]}
          >
            {!isVisible ? "Masqué" : statusLabel()}
          </span>
        </div>

        <div class="gallery-slot__toolstrip">
          <button
            type="button"
            class="admin-btn admin-btn--small"
            data-gallery-slot-panel-toggle
            aria-expanded="false"
            aria-controls={`gallery-slot-panel-${entry.position} gallery-slot-publish-group-${entry.position}`}
          >
            Modifier
          </button>
        </div>

        <div class="gallery-slot__panel" id={`gallery-slot-panel-${entry.position}`} data-gallery-slot-panel>
          <label class="gallery-slot__alt-label">
            Texte alternatif FR (obligatoire)
            <input type="text" name="altFr" required value={entry.item.alt_fr} />
          </label>
          <label class="gallery-slot__alt-label">
            Texte alternatif EN (obligatoire)
            <input type="text" name="altEn" required value={entry.item.alt_en} />
          </label>
          <label class="gallery-slot__caption-label">
            Légende ({locale.toUpperCase()})
            <Editable field="caption" locale={locale} editable>
              {(locale === "fr" ? entry.item.caption_fr : entry.item.caption_en) ?? ""}
            </Editable>
          </label>

          <label class="gallery-slot__featured-label">
            <input type="checkbox" name="featuredOnHome" checked={entry.item.featured_on_home === 1} />
            Afficher sur l'accueil
            <span class="gallery-slot__hint">Cette photo peut apparaître dans la sélection Travail de la page d'accueil.</span>
          </label>

          <div class="gallery-slot__focal-field">
            <p class="gallery-slot__field-label" id={`gallery-slot-focal-hint-${entry.position}`}>
              Point de mise au point <span class="gallery-slot__hint">(cliquer dans l'image, ou la sélectionner et utiliser les flèches du clavier — Maj + flèche pour un déplacement plus large)</span>
            </p>
            <div
              class="gallery-slot__focal-preview"
              data-gallery-slot-focal-preview
              role="group"
              tabindex="0"
              aria-label="Point de mise au point"
              aria-describedby={`gallery-slot-focal-hint-${entry.position}`}
            >
              <img
                src={mediaFileUrl(entry.item.media_id)}
                alt=""
                data-gallery-slot-focal-img
                style={`object-position: ${entry.item.focal_x}% ${entry.item.focal_y}%;`}
              />
              <span class="gallery-slot__focal-marker" data-gallery-slot-focal-marker style={`left: ${entry.item.focal_x}%; top: ${entry.item.focal_y}%;`} />
            </div>
          </div>

          <button type="submit" class="admin-btn">
            Enregistrer l'emplacement
          </button>
        </div>
      </form>

      {
        /**
         * Bug found while adding "Afficher sur l'accueil" (this
         * addendum): these 3 publish/language-status forms used to live
         * INSIDE .gallery-slot__panel, itself inside the media-form above
         * — a <form> nested inside another <form>, which is invalid HTML.
         * Browsers silently drop the inner <form> tag on parse, so every
         * button "inside" ends up bound to whichever form is still open —
         * on a page with more than one occupied slot, that can even be an
         * EARLIER slot's own form. This group is now a sibling of the
         * media-form instead (same pattern already used correctly for
         * Retirer/Remettre/Précédent/Suivant just below), each of its 3
         * forms genuinely independent. It keeps collapsing/expanding
         * together with .gallery-slot__panel — same toggle, same visible
         * boundary — via its own matching data-gallery-slot-panel marker
         * (the toggle script below now updates every element carrying
         * that attribute within the slot, not just the first).
         */
      }
      <div
        class="gallery-slot__publish-group"
        id={`gallery-slot-publish-group-${entry.position}`}
        data-gallery-slot-panel
      >
        {meta?.hasDraft && meta.draftId && (
          <form method="POST" action="/admin/site/travail/slot/publish" class="gallery-slot__inline-form">
            <input type="hidden" name="draftId" value={meta.draftId} />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small">
              Publier cet élément
            </button>
          </form>
        )}
        {!meta?.isNewDraft && meta?.frStatus !== null && meta?.frStatus !== undefined && (
          <form method="POST" action="/admin/site/travail/slot/language-status" class="gallery-slot__inline-form">
            <input type="hidden" name="publishedId" value={entry.item.id} />
            <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="status" value={meta.frStatus === "published" ? "draft" : "published"} />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small">
              {meta.frStatus === "published" ? "Dépublier FR" : "Publier FR"}
            </button>
          </form>
        )}
        {!meta?.isNewDraft && meta?.enStatus !== null && meta?.enStatus !== undefined && (
          <form method="POST" action="/admin/site/travail/slot/language-status" class="gallery-slot__inline-form">
            <input type="hidden" name="publishedId" value={entry.item.id} />
            <input type="hidden" name="locale" value="en" />
            <input type="hidden" name="status" value={meta.enStatus === "published" ? "draft" : "published"} />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small">
              {meta.enStatus === "published" ? "Dépublier EN" : "Publier EN"}
            </button>
          </form>
        )}
      </div>

      <div class="gallery-slot__toolstrip gallery-slot__toolstrip--secondary">
        {canReorder && !isFirstReorderable && (
          <form method="POST" action="/admin/site/travail/slot/move" class="gallery-slot__inline-form">
            <input type="hidden" name="workItemId" value={entry.item.id} />
            <input type="hidden" name="direction" value="prev" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small" aria-label="Déplacer cette photo vers la position précédente">
              ← Précédent
            </button>
          </form>
        )}
        {canReorder && !isLastReorderable && (
          <form method="POST" action="/admin/site/travail/slot/move" class="gallery-slot__inline-form">
            <input type="hidden" name="workItemId" value={entry.item.id} />
            <input type="hidden" name="direction" value="next" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small" aria-label="Déplacer cette photo vers la position suivante">
              Suivant →
            </button>
          </form>
        )}

        {isVisible ? (
          <form
            method="POST"
            action="/admin/site/travail/slot/visibility"
            class="gallery-slot__inline-form"
            data-confirm="Retirer cet élément de la galerie publique (après publication) ? Le média ne sera pas supprimé — vous pourrez le remettre à tout moment."
          >
            <input type="hidden" name="workItemId" value={entry.item.id} />
            <input type="hidden" name="isVisible" value="0" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small admin-btn--danger">
              Retirer
            </button>
          </form>
        ) : (
          <form method="POST" action="/admin/site/travail/slot/visibility" class="gallery-slot__inline-form">
            <input type="hidden" name="workItemId" value={entry.item.id} />
            <input type="hidden" name="isVisible" value="1" />
            <input type="hidden" name="redirect" value={redirectTo} />
            <button type="submit" class="admin-btn admin-btn--small">
              Remettre
            </button>
          </form>
        )}
      </div>
    </div>
  ) : (
    <div class="gallery-slot gallery-slot--empty" data-gallery-slot>
      <form method="POST" action="/admin/site/travail/slot/create" data-cms-form class="gallery-slot__create-form">
        <input type="hidden" name="position" value={entry.position} />
        <input type="hidden" name="ratio" value={entry.expectedShape.ratio} />
        <input type="hidden" name="redirect" value={redirectTo} />

        <div
          class="gallery-slot__placeholder"
          style={ratioStyle}
          data-cms-media-field="mediaId"
          data-cms-media-id=""
          data-cms-alt-prefill="true"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="gallery-slot__placeholder-icon">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.3" />
            <circle cx="8.5" cy="9" r="1.5" fill="currentColor" />
            <path d="M3 16.5 8 12l3.5 3.5L16 11l5 6" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
          <span class="gallery-slot__placeholder-ratio">{entry.expectedShape.ratioLabel}</span>
          <button type="button" class="gallery-slot__pick-btn" data-cms-open-media-picker="mediaId">
            + Ajouter une photo
          </button>
          <span class="gallery-slot__placeholder-selected">Photo sélectionnée</span>
        </div>

        <div class="gallery-slot__new-fields" data-gallery-slot-new-fields>
          <label class="gallery-slot__alt-label">
            Texte alternatif FR (obligatoire)
            <input type="text" name="altFr" required />
          </label>
          <label class="gallery-slot__alt-label">
            Texte alternatif EN (obligatoire)
            <input type="text" name="altEn" required />
          </label>
          <label class="gallery-slot__caption-input-label">
            Légende FR (optionnelle)
            <input type="text" name="captionFr" />
          </label>
          <label class="gallery-slot__caption-input-label">
            Légende EN (optionnelle)
            <input type="text" name="captionEn" />
          </label>

          <button type="submit" class="admin-btn">
            Créer l'élément (brouillon)
          </button>
        </div>
      </form>
    </div>
  )
}

<script>
  // Éditeur visuel Phase 3 — "Modifier" panel collapse toggle, same pattern
  // as EditorToolbar.astro's mobile menu (full HTML always server-rendered
  // for no-JS save; a class toggle purely controls visibility). Scoped via
  // the nearest `[data-gallery-slot]` ancestor rather than an id, since a
  // page can render many slots at once.
  //
  // Phase 4 addendum — `[data-gallery-slot-panel]` now matches TWO
  // sibling elements per slot (.gallery-slot__panel and
  // .gallery-slot__publish-group), split apart to fix the nested-<form>
  // bug (see the markup's own comment above .gallery-slot__publish-group)
  // without changing the collapsed/expanded behavior a visitor sees:
  // querySelectorAll + forEach toggles both together, same as the single
  // querySelector used to.
  document.querySelectorAll<HTMLButtonElement>("[data-gallery-slot-panel-toggle]").forEach((toggle) => {
    const slot = toggle.closest<HTMLElement>("[data-gallery-slot]");
    const panels = slot?.querySelectorAll<HTMLElement>("[data-gallery-slot-panel]");
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      panels?.forEach((panel) => panel.classList.toggle("gallery-slot__panel--expanded", !expanded));
    });
  });

  // Éditeur visuel Phase 3 — empty slot (Boris's brief §3: "jamais de champ
  // alt avant sélection de l'image"). The alt/caption fields stay hidden
  // until a media is actually picked. EditorToolbar.astro's shared picker
  // script is the thing that flips `data-cms-dirty` on the placeholder
  // (it owns the dialog, this component doesn't); watching that attribute
  // here keeps the two scripts decoupled instead of teaching the shared
  // picker about this component's own field layout.
  document.querySelectorAll<HTMLElement>(".gallery-slot__placeholder[data-cms-alt-prefill]").forEach((placeholder) => {
    const form = placeholder.closest("form");
    const fields = form?.querySelector<HTMLElement>("[data-gallery-slot-new-fields]");
    if (!fields) return;
    const sync = () => fields.classList.toggle("gallery-slot__new-fields--visible", placeholder.dataset.cmsDirty === "true");
    sync();
    new MutationObserver(sync).observe(placeholder, { attributes: true, attributeFilter: ["data-cms-dirty"] });
  });

  // Éditeur visuel Phase 3/4 — focal point (Boris's brief §10, Phase 4
  // audit §7): click inside the small preview OR use the keyboard to set
  // the point of interest, immediately visible (updates the same
  // preview's own object-position) and written into the hidden
  // focalX/focalY fields the media-form already submits. `applyFocal` is
  // the one place that touches the DOM/inputs, shared by the click and
  // keydown handlers below so both stay in sync by construction.
  function applyFocal(preview: HTMLElement, x: number, y: number): void {
    const clampedX = Math.round(Math.min(100, Math.max(0, x)));
    const clampedY = Math.round(Math.min(100, Math.max(0, y)));

    const img = preview.querySelector<HTMLImageElement>("[data-gallery-slot-focal-img]");
    if (img) img.style.objectPosition = `${clampedX}% ${clampedY}%`;
    const marker = preview.querySelector<HTMLElement>("[data-gallery-slot-focal-marker]");
    if (marker) {
      marker.style.left = `${clampedX}%`;
      marker.style.top = `${clampedY}%`;
    }

    const form = preview.closest("form");
    const xInput = form?.querySelector<HTMLInputElement>('[data-gallery-slot-focal-input="x"]');
    const yInput = form?.querySelector<HTMLInputElement>('[data-gallery-slot-focal-input="y"]');
    if (xInput) xInput.value = String(clampedX);
    if (yInput) yInput.value = String(clampedY);
  }

  document.querySelectorAll<HTMLElement>("[data-gallery-slot-focal-preview]").forEach((preview) => {
    preview.addEventListener("click", (event) => {
      const rect = preview.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width) * 100;
      const y = ((event.clientY - rect.top) / rect.height) * 100;
      applyFocal(preview, x, y);
    });

    // Keyboard equivalent (Phase 4 §5 — "point focal utilisable au
    // clavier", "interaction prévisible... pas de widget complexe"):
    // arrow keys nudge by a small step, Shift+arrow by a larger one,
    // reading the current value from the hidden inputs so repeated
    // presses accumulate correctly. `role="group"`/`tabindex="0"` on the
    // element (markup above) make it a normal Tab stop.
    preview.addEventListener("keydown", (event) => {
      const step = event.shiftKey ? 10 : 2;
      let dx = 0;
      let dy = 0;
      switch (event.key) {
        case "ArrowLeft":
          dx = -step;
          break;
        case "ArrowRight":
          dx = step;
          break;
        case "ArrowUp":
          dy = -step;
          break;
        case "ArrowDown":
          dy = step;
          break;
        default:
          return;
      }
      event.preventDefault();
      const form = preview.closest("form");
      const xInput = form?.querySelector<HTMLInputElement>('[data-gallery-slot-focal-input="x"]');
      const yInput = form?.querySelector<HTMLInputElement>('[data-gallery-slot-focal-input="y"]');
      const currentX = Number(xInput?.value ?? 50);
      const currentY = Number(yInput?.value ?? 50);
      applyFocal(preview, currentX + dx, currentY + dy);
    });
  });

  // "Retirer" confirmation (Boris's brief §4: "exiger une confirmation
  // avant l'action destructrice"). Purely a UX guard, not a security
  // boundary — the action underneath only ever sets is_visible=0 on a
  // draft (src/lib/admin/work-slot-actions.ts's setWorkSlotVisibilityAction),
  // never deletes anything, so a no-JS submit is still fully safe.
  document.querySelectorAll<HTMLFormElement>("form[data-confirm]").forEach((form) => {
    form.addEventListener("submit", (event) => {
      if (!confirm(form.dataset.confirm)) event.preventDefault();
    });
  });
</script>

<style>
  .gallery-slot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
  }

  .gallery-slot--occupied {
    border-style: solid;
    border-color: var(--color-border);
  }

  .gallery-slot__meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  /* Phase 4 §3 — the "Masqué" color/weight now comes from the shared
     .admin-badge--warn primitive; .gallery-slot__status-tag--hidden stays
     in the markup only as a stable test hook. */

  .gallery-slot__toolstrip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .gallery-slot__toolstrip--secondary {
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
    padding-top: var(--space-2);
  }

  /* Phase 3 — collapsible "Modifier" panel, same always-in-DOM /
     class-toggle pattern as EditorToolbar.astro's mobile menu. */
  .gallery-slot__panel {
    display: none;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }

  /* Phase 4 addendum — a sibling of .gallery-slot__panel now (not nested
     inside it, see the markup's own comment above .gallery-slot__publish-group),
     but visually still reads as part of the same collapsible block: same
     default-hidden/expanded toggle (.gallery-slot__panel--expanded, shared
     with .gallery-slot__panel via the JS above — this rule must stay
     BELOW both base rules in source order, since it ties with them on
     specificity and needs the later-wins tiebreak to actually show
     either one once expanded). No border-top of its own: .gallery-slot__panel
     right before it already provides that separator. */
  .gallery-slot__publish-group {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .gallery-slot__panel--expanded {
    display: flex;
  }

  .gallery-slot__caption-label,
  .gallery-slot__alt-label,
  .gallery-slot__caption-input-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .gallery-slot__alt-label input,
  .gallery-slot__caption-input-label input {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    padding: var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
  }

  .gallery-slot__field-label {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .gallery-slot__featured-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    font-size: var(--text-small);
    color: var(--color-text-primary);
  }

  .gallery-slot__featured-label .gallery-slot__hint {
    flex-basis: 100%;
    color: var(--color-text-secondary);
  }

  .gallery-slot__hint {
    opacity: 0.7;
    font-size: 0.8em;
  }

  .gallery-slot__focal-preview {
    position: relative;
    max-width: 12rem;
