---
import ImageFrame from "@/components/ImageFrame.astro";
import GalleryBlockFrame from "@/components/GalleryBlockFrame.astro";
import { placeholderPhotos } from "@/lib/placeholder-photos";
import type { GalleryBlock, GalleryImage } from "@/lib/gallery-blocks";

interface Props {
  blocks: GalleryBlock[];
}

const { blocks } = Astro.props;

/** Real CMS-sourced media sets `src` directly; mock pages still resolve through `placeholderPhotos` (Validation Brief 014S bug B). */
function resolveSrc(image: GalleryImage): string {
  return image.src ?? placeholderPhotos[image.mediaKey!];
}
---

<div class="work-gallery">
  {
    blocks.map((block) => {
      if (block.type === "duo") {
        return (
          <GalleryBlockFrame shape={block} reveal>
            <ImageFrame
              slot="item-0"
              src={resolveSrc(block.left)}
              alt={block.left.alt}
              ratio={block.left.ratio}
              focalX={block.left.focalX}
              focalY={block.left.focalY}
              class="media-hover"
            />
            <ImageFrame
              slot="item-1"
              src={resolveSrc(block.right)}
              alt={block.right.alt}
              ratio={block.right.ratio}
              focalX={block.right.focalX}
              focalY={block.right.focalY}
              class="media-hover"
            />
          </GalleryBlockFrame>
        );
      }

      if (block.type === "trio") {
        // Astro's compiler resolves `slot="..."` statically — a slot name
        // computed inside `.map()` (e.g. `slot={`item-${i}`}`) is NOT
        // supported and breaks SSR at runtime ("i is not defined", found
        // by this extraction's own before/after verification, never
        // reached staging). Unrolled into 3 static slot names instead —
        // same DOM/content as the dynamic version would have produced,
        // just spelled out so the compiler can see each name literally.
        const [first, second, third] = block.images;
        return (
          <GalleryBlockFrame shape={block} reveal>
            <ImageFrame slot="item-0" src={resolveSrc(first)} alt={first.alt} ratio={first.ratio} focalX={first.focalX} focalY={first.focalY} class="media-hover" />
            <ImageFrame slot="item-1" src={resolveSrc(second)} alt={second.alt} ratio={second.ratio} focalX={second.focalX} focalY={second.focalY} class="media-hover" />
            <ImageFrame slot="item-2" src={resolveSrc(third)} alt={third.alt} ratio={third.ratio} focalX={third.focalX} focalY={third.focalY} class="media-hover" />
          </GalleryBlockFrame>
        );
      }

      return (
        <GalleryBlockFrame shape={block} reveal>
          <ImageFrame
            slot="item-0"
            src={resolveSrc(block.image)}
            alt={block.image.alt}
            ratio={block.image.ratio}
            focalX={block.image.focalX}
            focalY={block.image.focalY}
            class="media-hover"
          />
        </GalleryBlockFrame>
      );
    })
  }
</div>

<style>
  .work-gallery {
    display: flex;
    flex-direction: column;
  }
</style>
