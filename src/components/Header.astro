---
import { getPath, type PageId } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import Container from "./Container.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import MobileNav from "./MobileNav.astro";

interface Props {
  locale: "fr" | "en";
  pageId: PageId;
  /** See BaseLayout.astro — only the homepage passes true. */
  transparentOverHero?: boolean;
}

const { locale, pageId, transparentOverHero = false } = Astro.props;
const copy = t(locale);

const links: { id: PageId; label: string }[] = [
  { id: "work", label: copy.nav.work },
  { id: "services", label: copy.nav.services },
  { id: "about", label: copy.nav.about },
  { id: "contact", label: copy.nav.contact },
];
---

<header class:list={["header", { "header--transparent": transparentOverHero }]}>
  <Container class="header__inner" as="div">
    <a class="header__wordmark" href={getPath("home", locale)}>
      {copy.siteName}
    </a>

    <nav class="header__nav" aria-label={copy.mainNavLabel}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={getPath(link.id, locale)}
                aria-current={pageId === link.id ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LanguageSwitcher locale={locale} pageId={pageId} />

      <button
        id="mobile-nav-open"
        class="header__menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        {copy.menuOpen}
      </button>
    </div>
  </Container>
</header>

<MobileNav locale={locale} pageId={pageId} />

<script>
  // No-op on every page except the homepage's transparent-over-hero header.
  const header = document.querySelector<HTMLElement>(".header--transparent");
  if (header) {
    const SCROLL_THRESHOLD = 40;
    const updateScrolledState = () => {
      header.classList.toggle("is-scrolled", window.scrollY > SCROLL_THRESHOLD);
    };
    updateScrolledState();
    window.addEventListener("scroll", updateScrolledState, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 80;
    background: color-mix(in srgb, var(--color-bg-primary) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: var(--border-width) solid var(--color-border);
    transition:
      background var(--transition-base),
      border-color var(--transition-base);
  }

  /* Floats transparently over the Hero photograph until the visitor
     scrolls, per Implementation Brief 002 section 13 — a small,
     prop-gated addition; every other page never sets this class and
     keeps today's default solid header untouched. */
  .header--transparent {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    position: absolute;
    top: 0;
    inset-inline: 0;
  }

  .header--transparent::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
    pointer-events: none;
  }

  .header--transparent.is-scrolled {
    position: sticky;
    background: color-mix(in srgb, var(--color-bg-primary) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--color-border);
  }

  .header--transparent.is-scrolled::before {
    display: none;
  }

  .header :global(.header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 4.5rem;
  }

  .header__wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-text-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-8);
  }

  .header__nav a {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .header__nav a:hover,
  .header__nav a:focus-visible,
  .header__nav a[aria-current="page"] {
    color: var(--color-text-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header__menu-button {
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    font-size: var(--text-small);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
  }

  @media (min-width: 1024px) {
    .header__nav {
      display: block;
    }

    .header__menu-button {
      display: none;
    }
  }
</style>
