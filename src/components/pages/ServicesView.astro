---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import EditorialLink from "@/components/EditorialLink.astro";
import ImageFrame from "@/components/ImageFrame.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { servicesMock } from "@/data/mock/services";
import { t } from "@/i18n/ui";
import { getDb } from "@/lib/db/client";
import { listPublishedServices, type ServiceWithFeatures } from "@/lib/db/services";
import { publicMediaFileUrl } from "@/lib/public-media";
import { resolveServiceLayout } from "@/lib/service-layout";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
// Page-level copy (title/intro/"Approche"/CTA final) stays on the mock —
// same deliberate, scoped decision as WorkView.astro's content.title/
// intro/ctaHeadline (services_page_content exists in D1 but editing it
// needs its own admin UI, out of scope for the Services CMS brief). Only
// the curated services array below reads real D1 state.
const content = servicesMock[locale];

let publishedServices: ServiceWithFeatures[] = [];
try {
  publishedServices = await listPublishedServices(getDb(), locale);
} catch (err) {
  console.error("public /services: D1 read failed", err instanceof Error ? err.message : err);
}

const localizedServices = publishedServices.map((service, index) => ({
  id: service.slug,
  title: locale === "fr" ? service.title_fr : service.title_en,
  tagline: locale === "fr" ? service.tagline_fr : service.tagline_en,
  description: locale === "fr" ? service.description_fr : service.description_en,
  features: (locale === "fr" ? service.features.map((f) => f.text_fr) : service.features.map((f) => f.text_en)).filter(
    (text) => text !== "",
  ),
  src: publicMediaFileUrl(service.media_id),
  ratio: service.ratio,
  imageAlt: locale === "fr" ? service.image_alt_fr : service.image_alt_en,
  ctaLabel: locale === "fr" ? service.cta_label_fr : service.cta_label_en,
  layout: resolveServiceLayout(service.slug, index),
}));
---

<BaseLayout
  locale={locale}
  pageId="services"
  title={content.title}
  description={content.intro}
>
  <Section spacing="tight">
    <Container>
      <div data-reveal>
        <Heading level={1} size="display">{content.title}</Heading>
        <Text as="p" size="lg" tone="secondary" class="services-intro__text">
          {content.intro}
        </Text>
      </div>
    </Container>
  </Section>

  {
    localizedServices.map((service, index) => (
      <Section background={index % 2 === 1 ? "secondary" : "primary"}>
        <Container>
          <div class={`service service--${service.layout}`} data-reveal>
            <div class="service__image-wrap">
              <ImageFrame
                src={service.src}
                alt={service.imageAlt}
                ratio={service.ratio}
                class="media-hover"
              />
            </div>
            <div class="service__copy">
              {/* level=2, not 3: an eyebrow label sits alongside the
                  service title (also level=2) as a sibling, matching the
                  eyebrow-label pattern used everywhere else on the site
                  (Home, About, Contact, Privacy) — level=3 here would
                  appear before any h2 in the section, breaking heading
                  order. Derived from position (01/02/03), same as
                  work_items — never a stored column, see 0001_initial.sql
                  "Service '01'/'02'/'03' eyebrow labels are derived from
                  `position` at render time, not stored". */}
              <Heading level={2} size="eyebrow">
                {String(index + 1).padStart(2, "0")}
              </Heading>
              <Heading level={2} size={service.layout === "wide-offset" ? "h1" : "h2"}>
                {service.title}
              </Heading>
              {service.tagline && (
                <Text as="p" size="lg" tone="secondary" class="service__tagline">
                  {service.tagline}
                </Text>
              )}
              <Text as="p" size="lg" class="service__description">
                {service.description}
              </Text>
              {service.features.length > 0 && (
                <ul class="service__features">
                  {service.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
              )}
              <EditorialLink href={getPath("contact", locale)}>
                {service.ctaLabel}
              </EditorialLink>
            </div>
          </div>
        </Container>
      </Section>
    ))
  }

  <Section aria-label={content.approachLabel}>
    <Container>
      <div data-reveal>
        <Heading level={2} size="eyebrow">{content.approachLabel}</Heading>
        <div class="approach">
          {
            content.approachSteps.map((step) => (
              <div class="approach__step">
                <Text as="span" size="lg" tone="secondary" class="approach__number">
                  {step.number}
                </Text>
                <Heading level={3} size="h3">
                  {step.title}
                </Heading>
                <Text as="p" tone="secondary">
                  {step.text}
                </Text>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </Section>

  <Section background="secondary" aria-label="Contact">
    <Container>
      <div data-reveal>
        <Heading level={2} size="display">{content.finalCta.headline}</Heading>
        <EditorialLink href={getPath("contact", locale)} class="services-cta__link">
          {copy.cta.contactUs}
        </EditorialLink>
      </div>
    </Container>
  </Section>
</BaseLayout>

<ScrollReveal />

<style>
  :global(.services-intro__text) {
    margin-top: var(--space-4);
    max-width: 30rem;
  }

  :global(.services-cta__link) {
    margin-top: var(--space-8);
  }

  /* SERVICE BLOCKS — mobile-first: always image, then copy, regardless
     of layout (section 21). Desktop layouts diverge below. */
  .service {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .service__image-wrap {
    order: 1;
  }

  .service__copy {
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 34rem;
  }

  :global(.service__tagline) {
    max-width: 30rem;
  }

  .service__description {
    color: var(--color-text-secondary);
  }

  .service__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .service__features li {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    border-left: var(--border-width) solid var(--color-border);
  }

  @media (min-width: 768px) {
    /* WIDE-OFFSET (Mariages) — large image, copy shifted left, never
       centered, narrower than the image above it. */
    .service--wide-offset .service__copy {
      width: 62%;
    }

    /* SPLIT (Portraits & Lifestyle) — genuine two-column row. */
    .service--split {
      flex-direction: row;
      align-items: center;
      gap: var(--space-12);
    }

    .service--split .service__image-wrap {
      flex: 5;
      order: 1;
    }

    .service--split .service__copy {
      flex: 7;
      order: 2;
    }

    /* TEXT-IMAGE (Événements) — copy first, then a large image below;
       reversed from wide-offset for real variety (section 9). */
    .service--text-image .service__copy {
      order: 1;
    }

    .service--text-image .service__image-wrap {
      order: 2;
    }
  }

  @media (min-width: 1024px) {
    .service--wide-offset .service__copy {
      width: 52%;
    }

    .service--split {
      gap: var(--space-16);
    }
  }

  /* APPROACH */
  .approach {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .approach__step {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.approach__number) {
    font-family: var(--font-serif);
  }

  @media (min-width: 768px) {
    .approach {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }
  }
</style>
