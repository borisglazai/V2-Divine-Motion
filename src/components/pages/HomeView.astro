---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import EditorialLink from "@/components/EditorialLink.astro";
import ImageFrame from "@/components/ImageFrame.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import Editable from "@/components/admin/Editable.astro";
import EditableImage from "@/components/admin/EditableImage.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { homeMock } from "@/data/mock/home";
import { placeholderPhotos } from "@/lib/placeholder-photos";
import { t } from "@/i18n/ui";
import { getDb } from "@/lib/db/client";
import { listPublishedTestimonials } from "@/lib/db/testimonials";
import { getMedia } from "@/lib/db/media";
import * as pages from "@/lib/db/pages";
import { listFeaturedOnHome } from "@/lib/db/work";
import { listPublishedServices, type ServiceWithFeatures } from "@/lib/db/services";
import { publicMediaFileUrl } from "@/lib/public-media";
import { mediaFileUrl } from "@/lib/admin/media-preview";
import type { HomeContentRow, TestimonialRow, WorkItemRow } from "@/lib/db/types";

interface Props {
  locale: Locale;
  /**
   * Éditeur visuel Phase 1 — "public" (default) is exactly today's
   * rendering, byte-for-byte. "edit"/"preview" are only ever passed by
   * src/pages/admin/site.astro (Access-gated) and read draft-or-published
   * `home_content` instead of the public/language-gated view — see
   * docs/CMS_SPEC.md "Éditeur visuel Phase 1" for the exact field scope
   * (hero headline/subline/media, brand statement, final CTA headline —
   * every other section here stays on the mock, unchanged).
   */
  mode?: "public" | "edit" | "preview";
  /** Only meaningful in edit mode — forwarded to BaseLayout so its Enregistrer button has a target. */
  saveAction?: string;
}

const { locale, mode = "public", saveAction } = Astro.props;
const editable = mode === "edit";
const copy = t(locale);
const content = homeMock[locale];

const title = locale === "fr" ? "Accueil" : "Home";
const description = content.hero.subline;

// Éditeur visuel Phase 1 — home_content read. Public mode only trusts it
// once the row exists AND the requested language is actually published
// (ADR-013's fr_status/en_status lever) — until an admin explicitly
// publishes, this stays byte-identical to the pre-existing mock-only
// rendering. Edit/preview modes always read draft-or-published, since an
// admin must see their own unpublished work.
let homeRow: HomeContentRow | null = null;
try {
  const db = getDb();
  homeRow = mode === "public" ? await pages.homeContent.getPublished(db) : ((await pages.homeContent.getDraft(db)) ?? (await pages.homeContent.getPublished(db)));
} catch (err) {
  console.error("HomeView: home_content D1 read failed", err instanceof Error ? err.message : err);
}

const langLive = homeRow !== null && (mode !== "public" || (locale === "fr" ? homeRow.fr_status === "published" : homeRow.en_status === "published"));

const heroHeadline = langLive ? (locale === "fr" ? homeRow!.hero_headline_fr : homeRow!.hero_headline_en) : content.hero.headline;
const heroSubline = langLive ? (locale === "fr" ? homeRow!.hero_subline_fr : homeRow!.hero_subline_en) : content.hero.subline;
const brandStatement = langLive ? (locale === "fr" ? homeRow!.brand_statement_fr : homeRow!.brand_statement_en) : content.brandStatement;
const finalCtaHeadline = langLive ? (locale === "fr" ? homeRow!.final_cta_headline_fr : homeRow!.final_cta_headline_en) : content.finalCta.headline;

let heroImageSrc: string = placeholderPhotos.a;
let heroImageAlt = content.hero.imageAlt;
let heroFocalX: number | undefined;
let heroFocalY: number | undefined;
const heroMediaId = homeRow?.hero_media_id ?? 0;
if (langLive && homeRow) {
  try {
    const media = await getMedia(getDb(), homeRow.hero_media_id);
    if (media) {
      heroImageSrc = mode === "public" ? publicMediaFileUrl(homeRow.hero_media_id) : mediaFileUrl(homeRow.hero_media_id);
      heroImageAlt = locale === "fr" ? homeRow.hero_image_alt_fr : homeRow.hero_image_alt_en;
      heroFocalX = media.focal_x;
      heroFocalY = media.focal_y;
    }
  } catch (err) {
    console.error("HomeView: hero media D1 read failed", err instanceof Error ? err.message : err);
  }
}

// Témoignages CMS: the only Home section backed by real D1 (every other
// section here is still homeMock — out of scope for this brief, same
// deliberate scope line already drawn for Travail/Services). Fails
// closed to an empty list, never a page-level 500 (see
// WorkView.astro/ServicesView.astro for the same pattern) — the section
// itself is skipped entirely below when there's nothing to show, rather
// than rendering an empty shell.
let testimonials: TestimonialRow[] = [];
try {
  testimonials = await listPublishedTestimonials(getDb(), locale);
} catch (err) {
  console.error("public / (home): testimonials D1 read failed", err instanceof Error ? err.message : err);
}

// Travail preview: real featured work_items, not homeMock. Travail stays
// the single source of truth — `featured_on_home`, order, media and
// publication are curated from /admin/work only, never from a
// Home-specific control (Boris's Visual Editor Phase 4 addendum). Reuses
// listFeaturedOnHome (src/lib/db/work.ts) as-is: same published/visible/
// language-status gate as the public Travail page, already ordered by
// position. Capped at 6 (the mosaic's fixed slot count); fewer than 6 is
// rendered as-is (see the count-aware `.work-mosaic` CSS below) rather
// than padded with placeholders. Zero featured items hides the whole
// section — same fail-closed pattern as Témoignages above, never a
// fallback to placeholderPhotos.
let featuredWork: WorkItemRow[] = [];
try {
  featuredWork = (await listFeaturedOnHome(getDb(), locale)).slice(0, 6);
} catch (err) {
  console.error("public / (home): featured work D1 read failed", err instanceof Error ? err.message : err);
}

// Services preview: real published services, not homeMock. Services stays
// the single source of truth for these 3 cards — same reasoning as
// Travail above. Reuses listPublishedServices (src/lib/db/services.ts)
// as-is (its batched `service_features` fetch is simply unused here, not
// worth a second, narrower DAL function for). Capped at 3 (the existing
// editorial layout's card count); fewer than 3 renders cleanly since
// `.services-editorial`'s CSS grid already degrades gracefully with unused
// trailing columns. Zero published services hides the section, same
// fail-closed pattern.
let previewServices: ServiceWithFeatures[] = [];
try {
  previewServices = (await listPublishedServices(getDb(), locale)).slice(0, 3);
} catch (err) {
  console.error("public / (home): services preview D1 read failed", err instanceof Error ? err.message : err);
}
---

<BaseLayout
  locale={locale}
  pageId="home"
  title={title}
  description={description}
  transparentHeaderOverHero
  editorFormAction={editable ? saveAction : undefined}
>
  <!-- HERO -->
  <section class="hero">
    <EditableImage
      field="heroMediaId"
      src={heroImageSrc}
      alt={heroImageAlt}
      mediaId={heroMediaId}
      focalX={heroFocalX}
      focalY={heroFocalY}
      editable={editable}
      fill
      loading="eager"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
    <Container class="hero__content">
      <div data-reveal>
        <Heading level={1} size="display-xl">
          <Editable field={locale === "fr" ? "heroHeadlineFr" : "heroHeadlineEn"} locale={locale} editable={editable}>
            {heroHeadline}
          </Editable>
        </Heading>
        <Text as="p" size="lg" class="hero__subline">
          <Editable field={locale === "fr" ? "heroSublineFr" : "heroSublineEn"} locale={locale} editable={editable} multiline>
            {heroSubline}
          </Editable>
        </Text>
        <div class="hero__ctas">
          <EditorialLink href={getPath("work", locale)}>
            {content.workPreview.linkLabel}
          </EditorialLink>
          <a class="hero__secondary-link" href={getPath("contact", locale)}>
            {copy.cta.talkProject}
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- WORK PREVIEW — a curated selection of media, not a Projects grid
       (docs/decisions/ADR-003-curated-work-vs-project-model.md). Real
       work_items (featured_on_home), not homeMock — see the featuredWork
       read above. Hidden entirely when nothing is featured, never a
       placeholder fallback. -->
  {
    featuredWork.length > 0 && (
      <Section aria-label={content.workPreview.label}>
        <Container>
          <div data-reveal>
            <Heading level={2} size="eyebrow">{content.workPreview.label}</Heading>
            <div class="work-mosaic" data-count={featuredWork.length}>
              {featuredWork.map((item) => (
                <div class="work-mosaic__item">
                  <ImageFrame
                    src={publicMediaFileUrl(item.media_id)}
                    alt={locale === "fr" ? item.alt_fr : item.alt_en}
                    ratio={item.ratio}
                    focalX={item.focal_x}
                    focalY={item.focal_y}
                    class="media-hover"
                  />
                </div>
              ))}
            </div>
            <EditorialLink href={getPath("work", locale)} class="work-mosaic__link">
              {content.workPreview.linkLabel}
            </EditorialLink>
          </div>
        </Container>
      </Section>
    )
  }

  <!-- BRAND STATEMENT -->
  <Section background="secondary" aria-label="Brand statement">
    <Container>
      <div data-reveal>
        <Heading level={2} size="display">
          <Editable field={locale === "fr" ? "brandStatementFr" : "brandStatementEn"} locale={locale} editable={editable} multiline>
            {brandStatement}
          </Editable>
        </Heading>
      </div>
    </Container>
  </Section>

  <!-- SERVICES PREVIEW — announces the 3 universes, never a condensed
       Services page (see Implementation Brief 002, section 9). Real
       published services, not homeMock — see the previewServices read
       above. Hidden entirely when nothing is published, never a
       placeholder fallback. -->
  {
    previewServices.length > 0 && (
      <Section aria-label={content.servicesPreview.label}>
        <Container>
          <div data-reveal>
            <Heading level={2} size="eyebrow">{content.servicesPreview.label}</Heading>
            <div class="services-editorial">
              {previewServices.map((service) => (
                <a class="services-editorial__item" href={getPath("services", locale)}>
                  {/* alt="" deliberately: the visible heading right below
                      already names this service, so the image is decorative
                      in this context — not an oversight. */}
                  <ImageFrame
                    src={publicMediaFileUrl(service.media_id)}
                    alt=""
                    ratio={service.ratio}
                    class="media-hover"
                  />
                  <Heading level={3} size="h3">
                    {locale === "fr" ? service.title_fr : service.title_en}
                  </Heading>
                  <Text as="p" size="body" tone="secondary">
                    {locale === "fr" ? service.description_fr : service.description_en}
                  </Text>
                </a>
              ))}
            </div>
          </div>
        </Container>
      </Section>
    )
  }

  <!-- TESTIMONIALS — Témoignages CMS. Reintroduces the Master Brief §13
       section (dropped from the 15 September redesign's home structure),
       decided explicitly for this brief. Sober, editorial: a quote and a
       name, never a SaaS review card (star ratings, quote-bubble icons,
       carousels). Skipped entirely when there's nothing published — an
       empty section shell would break the page's own "reste court" rule. -->
  {
    testimonials.length > 0 && (
      <Section aria-label={copy.testimonials.label}>
        <Container>
          <div data-reveal>
            <Heading level={2} size="eyebrow">
              {copy.testimonials.label}
            </Heading>
            <div class="testimonials-grid">
              {testimonials.map((testimonial) => (
                <figure class="testimonial">
                  {testimonial.photo_media_id && (
                    <ImageFrame
                      src={publicMediaFileUrl(testimonial.photo_media_id)}
                      alt=""
                      ratio="1 / 1"
                      class="testimonial__avatar"
                    />
                  )}
                  <blockquote class="testimonial__quote">
                    <Text as="p" size="lg">
                      {locale === "fr" ? testimonial.quote_fr : testimonial.quote_en}
                    </Text>
                  </blockquote>
                  <figcaption class="testimonial__meta">
                    <Text as="span" size="body" class="testimonial__name">
                      {testimonial.author_name}
                    </Text>
                    {(locale === "fr" ? testimonial.role_context_fr : testimonial.role_context_en) && (
                      <Text as="span" size="small" tone="secondary">
                        {locale === "fr" ? testimonial.role_context_fr : testimonial.role_context_en}
                      </Text>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </Container>
      </Section>
    )
  }

  <!-- EDITORIAL IMAGE / RESPIRATION — no text by design (section 10). -->
  <Section spacing="none">
    <div data-reveal>
      <ImageFrame
        src={placeholderPhotos.e}
        alt={content.editorial.imageAlt}
        ratio="21 / 9"
        class="media-hover"
      />
    </div>
  </Section>

  <!-- ABOUT PREVIEW -->
  <Section aria-label={content.aboutPreview.label}>
    <Container class="about-preview">
      <div class="about-preview__media" data-reveal>
        <ImageFrame
          src={placeholderPhotos.d}
          alt={content.aboutPreview.imageAlt}
          ratio="4 / 5"
          class="media-hover"
        />
      </div>
      <div class="about-preview__copy" data-reveal>
        <Heading level={2} size="eyebrow">{content.aboutPreview.label}</Heading>
        <Text as="p" size="lg">{content.aboutPreview.text}</Text>
        <EditorialLink href={getPath("about", locale)}>
          {copy.cta.discoverAbout}
        </EditorialLink>
      </div>
    </Container>
  </Section>

  <!-- FINAL CONTACT CTA -->
  <Section background="secondary" aria-label="Contact">
    <Container>
      <div data-reveal>
        <Heading level={2} size="display">
          <Editable field={locale === "fr" ? "finalCtaHeadlineFr" : "finalCtaHeadlineEn"} locale={locale} editable={editable} multiline>
            {finalCtaHeadline}
          </Editable>
        </Heading>
        <EditorialLink href={getPath("contact", locale)} class="final-cta__link">
          {copy.cta.contactUs}
        </EditorialLink>
      </div>
    </Container>
  </Section>

  <slot name="admin-chrome" slot="admin-chrome" />
</BaseLayout>

<ScrollReveal />

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: min(88vh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-bg-secondary);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.75) 0%,
      rgba(0, 0, 0, 0.25) 45%,
      rgba(0, 0, 0, 0.05) 75%
    );
  }

  :global(.hero__content) {
    position: relative;
    z-index: 1;
    padding-block: var(--space-16);
  }

  .hero__content > div {
    max-width: 44rem;
  }

  :global(.hero__subline) {
    margin-top: var(--space-4);
    color: var(--color-text-primary);
    max-width: 32rem;
  }

  .hero__ctas {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }

  .hero__secondary-link {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hero__secondary-link:hover,
  .hero__secondary-link:focus-visible {
    color: var(--color-text-primary);
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 78vh;
      align-items: flex-end;
    }

    .hero__content > div {
      max-width: none;
    }
  }

  /* WORK PREVIEW MOSAIC */
  .work-mosaic {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* :global() — passed to the child EditorialLink component. */
  :global(.work-mosaic__link) {
    margin-top: var(--space-8);
    display: inline-flex;
  }

  @media (min-width: 768px) {
    .work-mosaic {
      grid-template-columns: repeat(4, 1fr);
    }

    .work-mosaic__item:nth-child(1) {
      grid-column: span 4;
    }
    .work-mosaic__item:nth-child(2) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(3) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(4) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(5) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(6) {
      grid-column: span 4;
    }

    /* Count-aware overrides (Éditeur visuel Phase 4 addendum) —
       featuredWork can have 1-6 real items (not every published item is
       featured_on_home). The rules above are tuned for exactly 6 and,
       unmodified, leave an incomplete/short last row for some counts (a
       "trou visuel incohérent"). 5 already sums correctly as-is (4+2+2 =
       one full row) — only 1/2/4 need an override, scoped here (and
       re-stated in the 1024px block below) so they never leak into the
       single-column mobile layout or fight the desktop spans on
       specificity. Same visual language as the 6-item composition, not a
       new layout system. */
    .work-mosaic[data-count="1"] .work-mosaic__item:nth-child(1) {
      grid-column: span 4;
    }

    .work-mosaic[data-count="2"] .work-mosaic__item:nth-child(1),
    .work-mosaic[data-count="2"] .work-mosaic__item:nth-child(2) {
      grid-column: span 2;
    }

    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(1),
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(4) {
      grid-column: span 4;
    }
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(2),
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(3) {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .work-mosaic {
      grid-template-columns: repeat(6, 1fr);
    }

    .work-mosaic__item:nth-child(1) {
      grid-column: span 3;
    }
    .work-mosaic__item:nth-child(2) {
      grid-column: span 3;
    }
    .work-mosaic__item:nth-child(3) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(4) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(5) {
      grid-column: span 2;
    }
    .work-mosaic__item:nth-child(6) {
      grid-column: span 6;
    }

    /* Count-aware overrides, desktop grid (6 columns) — re-stated here
       (rather than left to the 768px block above) since that block's own
       min-width also matches at this width: every count that needs a
       different desktop composition, INCLUDING count 2 (whose tablet
       override would otherwise win here too on specificity), gets its
       desktop-specific spans explicitly. 3 items only needs an override
       here (its tablet composition — 4+2+2 — already sums correctly). */
    .work-mosaic[data-count="1"] .work-mosaic__item:nth-child(1) {
      grid-column: span 6;
    }

    .work-mosaic[data-count="2"] .work-mosaic__item:nth-child(1),
    .work-mosaic[data-count="2"] .work-mosaic__item:nth-child(2) {
      grid-column: span 3;
    }

    .work-mosaic[data-count="3"] .work-mosaic__item:nth-child(1) {
      grid-column: span 6;
    }
    .work-mosaic[data-count="3"] .work-mosaic__item:nth-child(2),
    .work-mosaic[data-count="3"] .work-mosaic__item:nth-child(3) {
      grid-column: span 3;
    }

    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(1),
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(2),
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(3),
    .work-mosaic[data-count="4"] .work-mosaic__item:nth-child(4) {
      grid-column: span 3;
    }
  }

  /* SERVICES PREVIEW — editorial, not cards */
  .services-editorial {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .services-editorial__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
  }

  .services-editorial__item :global(.heading) {
    transition: color var(--transition-fast);
  }

  .services-editorial__item:hover :global(.heading),
  .services-editorial__item:focus-visible :global(.heading) {
    color: var(--color-accent-warm);
  }

  @media (min-width: 1024px) {
    .services-editorial {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-8);
    }

    .services-editorial__item:nth-child(2) {
      margin-top: var(--space-16);
    }
  }

  /* TESTIMONIALS — editorial, not review cards: no borders/shadows/star
     ratings, just serif-body quote + name, same visual register as the
     rest of the page. */
  .testimonials-grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
  }

  .testimonial__avatar {
    width: 3.5rem;
    border-radius: 50%;
    overflow: hidden;
  }

  .testimonial__quote {
    margin: 0;
  }

  .testimonial__quote :global(p) {
    color: var(--color-text-primary);
  }

  .testimonial__quote :global(p)::before {
    content: "“";
  }

  .testimonial__quote :global(p)::after {
    content: "”";
  }

  .testimonial__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  :global(.testimonial__name) {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-16) var(--space-8);
    }
  }

  /* ABOUT PREVIEW */
  :global(.about-preview) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .about-preview__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  @media (min-width: 1024px) {
    :global(.about-preview) {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-16);
    }
  }

  /* FINAL CTA — :global() — passed to the child EditorialLink component. */
  :global(.final-cta__link) {
    margin-top: var(--space-8);
  }
</style>
