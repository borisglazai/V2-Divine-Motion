---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import EditorialLink from "@/components/EditorialLink.astro";
import WorkGallery from "@/components/WorkGallery.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { workMock } from "@/data/mock/work";
import { t } from "@/i18n/ui";
import { getDb } from "@/lib/db/client";
import { listPublishedWorkItems } from "@/lib/db/work";
import { buildGalleryFromWorkItems } from "@/lib/work-gallery-adapter";
import type { GalleryBlock } from "@/lib/gallery-blocks";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const content = workMock[locale];

// Validation Brief 014S bug B: the curated *sequence* (title/intro/CTA
// copy) is still page-level content (workMock — out of scope for this
// fix, belongs to work_page_content, a separate table this brief never
// touches). The *gallery* itself now reads real published work_items —
// this page used to render nothing but mock data regardless of what the
// CMS held, so "Élément publié" in the admin never had any visible
// effect here. Fails closed to an empty gallery (never the page-level
// 500 a D1 error would otherwise cause) — a real visitor seeing a quiet
// section is better than a broken page.
let gallery: GalleryBlock[] = [];
try {
  const items = await listPublishedWorkItems(getDb(), locale);
  gallery = buildGalleryFromWorkItems(items, locale);
} catch (err) {
  console.error("public /travail: D1 read failed", err instanceof Error ? err.message : err);
}

const description =
  locale === "fr"
    ? "Une sélection curatée du travail de Divine Motion."
    : "A curated selection of Divine Motion's work.";
---

<BaseLayout locale={locale} pageId="work" title={content.title} description={description}>
  <Section spacing="tight">
    <Container>
      <div data-reveal>
        <Heading level={1} size="display">{content.title}</Heading>
        <Text as="p" size="lg" tone="secondary" class="work-intro__text">
          {content.intro}
        </Text>
      </div>
    </Container>
  </Section>

  <Section spacing="none">
    <Container>
      <WorkGallery blocks={gallery} />
    </Container>
  </Section>

  <Section background="secondary" aria-label="Contact">
    <Container>
      <div data-reveal>
        <Heading level={2} size="display">{content.ctaHeadline}</Heading>
        <EditorialLink href={getPath("contact", locale)} class="work-cta__link">
          {copy.cta.talkProject}
        </EditorialLink>
      </div>
    </Container>
  </Section>
</BaseLayout>

<ScrollReveal />

<style>
  :global(.work-intro__text) {
    margin-top: var(--space-4);
    max-width: 28rem;
  }

  :global(.work-cta__link) {
    margin-top: var(--space-8);
  }
</style>
