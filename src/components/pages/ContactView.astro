---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import PrimaryButton from "@/components/PrimaryButton.astro";
import Editable from "@/components/admin/Editable.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { contactMock } from "@/data/mock/contact";
import { t } from "@/i18n/ui";
import { getDb } from "@/lib/db/client";
import * as pages from "@/lib/db/pages";
import type { ContactContentRow } from "@/lib/db/types";
import type { ContactFormErrors } from "@/lib/contact/validation";
import type { Flash } from "@/lib/admin/flash";

interface ContactFormValues {
  name?: string;
  email?: string;
  phone?: string;
  serviceType?: string;
  date?: string;
  location?: string;
  message?: string;
}

interface Props {
  locale: Locale;
  /**
   * Éditeur visuel Phase 2 — same 3-mode convention as the other 4 pages.
   * Editorial content only (Boris's brief: hero title/intro, details
   * label, closing note) — the CONTENT around the form is what this mode
   * affects; the form itself (Production Readiness — Step 1) is wired to
   * a real POST/Turnstile/email backend only when `mode === "public"`,
   * so the admin editor's Contact page keeps its pre-existing,
   * non-submitting button (no regression).
   */
  mode?: "public" | "edit" | "preview";
  saveAction?: string;
  /** Public form POST handling (src/pages/contact.astro / en/contact.astro) — all optional so the admin editor call site above needs no changes. */
  formErrors?: ContactFormErrors;
  formValues?: ContactFormValues;
  formError?: string;
  flash?: Flash | null;
  turnstileSiteKey?: string | null;
}

const { locale, mode = "public", saveAction, formErrors, formValues, formError, flash = null, turnstileSiteKey = null } = Astro.props;
const editable = mode === "edit";
const isPublic = mode === "public";
const copy = t(locale);
const form = copy.contactForm;
const content = contactMock[locale];
const fv = formValues ?? {};

let contactRow: ContactContentRow | null = null;
try {
  const db = getDb();
  contactRow = mode === "public" ? await pages.contactContent.getPublished(db) : ((await pages.contactContent.getDraft(db)) ?? (await pages.contactContent.getPublished(db)));
} catch (err) {
  console.error("ContactView: contact_content D1 read failed", err instanceof Error ? err.message : err);
}

const langLive = contactRow !== null && (mode !== "public" || (locale === "fr" ? contactRow.fr_status === "published" : contactRow.en_status === "published"));

const heroTitle = langLive ? (locale === "fr" ? contactRow!.hero_title_fr : contactRow!.hero_title_en) : content.hero.title;
const heroSubtext = langLive ? (locale === "fr" ? contactRow!.hero_subtext_fr : contactRow!.hero_subtext_en) : content.hero.subtext;
const detailsLabel = langLive ? (locale === "fr" ? contactRow!.details_label_fr : contactRow!.details_label_en) : content.details.label;
const closingNote = langLive ? (locale === "fr" ? contactRow!.closing_note_fr : contactRow!.closing_note_en) : content.closingNote;
---

<BaseLayout
  locale={locale}
  pageId="contact"
  title={heroTitle}
  description={heroSubtext}
  editorFormAction={editable ? saveAction : undefined}
>
  <Section spacing="tight">
    <Container class="contact-hero">
      <div data-reveal>
        <Heading level={1} size="display" id="contact-heading">
          <Editable field={locale === "fr" ? "heroTitleFr" : "heroTitleEn"} locale={locale} editable={editable}>
            {heroTitle}
          </Editable>
        </Heading>
        <Text as="p" size="lg" tone="secondary" class="contact-hero__subtext">
          <Editable field={locale === "fr" ? "heroSubtextFr" : "heroSubtextEn"} locale={locale} editable={editable} multiline>
            {heroSubtext}
          </Editable>
        </Text>
      </div>
    </Container>
  </Section>

  <Section spacing="tight">
    <Container class="contact-form-wrap">
      {isPublic && <FlashMessage flash={flash} />}

      <form class="contact-form" aria-labelledby="contact-heading" data-reveal method={isPublic ? "POST" : undefined} novalidate={isPublic}>
        {formError && (
          <div class="contact-form__field contact-form__field--full">
            <p class="contact-form__form-error" role="alert">{formError}</p>
          </div>
        )}

        <div class="contact-form__field">
          <label for="name">{form.name}</label>
          <input type="text" id="name" name="name" autocomplete="name" required value={fv.name ?? ""} aria-invalid={formErrors?.name ? "true" : undefined} aria-describedby={formErrors?.name ? "name-error" : undefined} />
          {formErrors?.name && <p class="contact-form__field-error" id="name-error" role="alert">{formErrors.name}</p>}
        </div>

        <div class="contact-form__field">
          <label for="email">{form.email}</label>
          <input type="email" id="email" name="email" autocomplete="email" required value={fv.email ?? ""} aria-invalid={formErrors?.email ? "true" : undefined} aria-describedby={formErrors?.email ? "email-error" : undefined} />
          {formErrors?.email && <p class="contact-form__field-error" id="email-error" role="alert">{formErrors.email}</p>}
        </div>

        <div class="contact-form__field">
          <label for="phone">{form.phone}</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" value={fv.phone ?? ""} />
        </div>

        <div class="contact-form__field">
          <label for="serviceType">{form.serviceType}</label>
          <select id="serviceType" name="serviceType" required aria-invalid={formErrors?.serviceType ? "true" : undefined} aria-describedby={formErrors?.serviceType ? "serviceType-error" : undefined}>
            <option value="" selected={!fv.serviceType} disabled hidden></option>
            {form.serviceTypeOptions.map((option) => <option value={option} selected={fv.serviceType === option}>{option}</option>)}
          </select>
          {formErrors?.serviceType && <p class="contact-form__field-error" id="serviceType-error" role="alert">{formErrors.serviceType}</p>}
        </div>

        <div class="contact-form__field">
          <label for="date">{form.date}</label>
          <input type="date" id="date" name="date" value={fv.date ?? ""} />
        </div>

        <div class="contact-form__field">
          <label for="location">{form.location}</label>
          <input type="text" id="location" name="location" value={fv.location ?? ""} />
        </div>

        <div class="contact-form__field contact-form__field--full">
          <label for="message">{form.message}</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            placeholder={form.messagePlaceholder}
            aria-invalid={formErrors?.message ? "true" : undefined}
            aria-describedby={formErrors?.message ? "message-error" : undefined}
          >{fv.message ?? ""}</textarea>
          {formErrors?.message && <p class="contact-form__field-error" id="message-error" role="alert">{formErrors.message}</p>}
        </div>

        <div class="contact-form__field contact-form__field--full">
          <Text as="p" size="small" tone="secondary">
            {form.privacyNotice}{" "}
            <a href={getPath("privacy", locale)}>{copy.footer.privacy}</a>
          </Text>
        </div>

        {isPublic && turnstileSiteKey && (
          <div class="contact-form__field contact-form__field--full">
            <span class="contact-form__turnstile-label">{form.turnstileLabel}</span>
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          </div>
        )}

        <div class="contact-form__field contact-form__field--full">
          {
            isPublic ? (
              // Real submission (Production Readiness — Step 1): PrimaryButton's
              // `type` prop is set to "submit" explicitly here only — every
              // other call site (incl. the admin editor's Contact page below)
              // keeps the default type="button", so nothing else can trigger a
              // submission.
              <PrimaryButton type="submit">{form.submit}</PrimaryButton>
            ) : (
              <PrimaryButton>{form.submit}</PrimaryButton>
            )
          }
        </div>
      </form>

      {isPublic && turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
    </Container>
  </Section>

  <Section aria-label={detailsLabel}>
    <Container class="contact-details">
      <div data-reveal>
        <Heading level={2} size="eyebrow">
          <Editable field={locale === "fr" ? "detailsLabelFr" : "detailsLabelEn"} locale={locale} editable={editable}>
            {detailsLabel}
          </Editable>
        </Heading>
        <ul class="contact-details__list">
          {content.details.items.map((item) => (
            <li>
              <span class="contact-details__label">{item.label}</span>
              <a href={item.href}>{item.value}</a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <Section background="secondary">
    <Container>
      <div data-reveal>
        <Heading level={2} size="h2" class="contact-closing">
          <Editable field={locale === "fr" ? "closingNoteFr" : "closingNoteEn"} locale={locale} editable={editable} multiline>
            {closingNote}
          </Editable>
        </Heading>
      </div>
    </Container>
  </Section>

  <slot name="admin-chrome" slot="admin-chrome" />
</BaseLayout>

<ScrollReveal />

<style>
  /* :global() — passed to child components (Container, Text, Heading),
     outside this file's own CSS scope. */
  :global(.contact-hero) {
    max-width: 34rem;
  }

  :global(.contact-hero__subtext) {
    margin-top: var(--space-4);
  }

  :global(.contact-form-wrap) {
    max-width: 40rem;
  }

  :global(.contact-details) {
    max-width: 34rem;
  }

  :global(.contact-closing) {
    max-width: 30rem;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  .contact-form__field-error {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: #c2554b;
  }

  .contact-form__form-error {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-primary);
    background: color-mix(in srgb, #c2554b 12%, transparent);
    border: var(--border-width) solid #c2554b;
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .contact-form__turnstile-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  input[aria-invalid="true"],
  select[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: #c2554b;
  }

  input,
  select,
  textarea {
    background: var(--color-bg-secondary);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-primary);
    font-size: var(--text-body);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent-warm);
  }

  textarea {
    resize: vertical;
  }

  .contact-details__list {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-details__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .contact-details__label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    min-width: 6rem;
  }

  .contact-details__list a {
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-details__list a:hover,
  .contact-details__list a:focus-visible {
    color: var(--color-accent-warm);
  }

  @media (max-width: 768px) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
