---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import PrimaryButton from "@/components/PrimaryButton.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { contactMock } from "@/data/mock/contact";
import { t } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const form = copy.contactForm;
const content = contactMock[locale];
---

<BaseLayout
  locale={locale}
  pageId="contact"
  title={content.hero.title}
  description={content.hero.subtext}
>
  <Section spacing="tight">
    <Container class="contact-hero">
      <div data-reveal>
        <Heading level={1} size="display" id="contact-heading">
          {content.hero.title}
        </Heading>
        <Text as="p" size="lg" tone="secondary" class="contact-hero__subtext">
          {content.hero.subtext}
        </Text>
      </div>
    </Container>
  </Section>

  <Section spacing="tight">
    <Container class="contact-form-wrap">
      <form class="contact-form" aria-labelledby="contact-heading" data-reveal>
        <div class="contact-form__field">
          <label for="name">{form.name}</label>
          <input type="text" id="name" name="name" autocomplete="name" required />
        </div>

        <div class="contact-form__field">
          <label for="email">{form.email}</label>
          <input type="email" id="email" name="email" autocomplete="email" required />
        </div>

        <div class="contact-form__field">
          <label for="phone">{form.phone}</label>
          <input type="tel" id="phone" name="phone" autocomplete="tel" />
        </div>

        <div class="contact-form__field">
          <label for="serviceType">{form.serviceType}</label>
          <select id="serviceType" name="serviceType" required>
            {form.serviceTypeOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>

        <div class="contact-form__field">
          <label for="date">{form.date}</label>
          <input type="date" id="date" name="date" />
        </div>

        <div class="contact-form__field">
          <label for="location">{form.location}</label>
          <input type="text" id="location" name="location" />
        </div>

        <div class="contact-form__field contact-form__field--full">
          <label for="message">{form.message}</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            placeholder={form.messagePlaceholder}
          ></textarea>
        </div>

        <div class="contact-form__field contact-form__field--full">
          <Text as="p" size="small" tone="secondary">
            {form.privacyNotice}{" "}
            <a href={getPath("privacy", locale)}>{copy.footer.privacy}</a>
          </Text>
        </div>

        <div class="contact-form__field contact-form__field--full">
          <!-- No `type="submit"` — PrimaryButton defaults to type="button",
               so this can never trigger a real form submission (section
               10/26: visual only, no backend, no fake success message). -->
          <PrimaryButton>{form.submit}</PrimaryButton>
        </div>
      </form>
    </Container>
  </Section>

  <Section aria-label={content.details.label}>
    <Container class="contact-details">
      <div data-reveal>
        <Heading level={2} size="eyebrow">{content.details.label}</Heading>
        <ul class="contact-details__list">
          {content.details.items.map((item) => (
            <li>
              <span class="contact-details__label">{item.label}</span>
              <a href={item.href}>{item.value}</a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </Section>

  <Section background="secondary">
    <Container>
      <div data-reveal>
        <Heading level={2} size="h2" class="contact-closing">
          {content.closingNote}
        </Heading>
      </div>
    </Container>
  </Section>
</BaseLayout>

<ScrollReveal />

<style>
  /* :global() — passed to child components (Container, Text, Heading),
     outside this file's own CSS scope. */
  :global(.contact-hero) {
    max-width: 34rem;
  }

  :global(.contact-hero__subtext) {
    margin-top: var(--space-4);
  }

  :global(.contact-form-wrap) {
    max-width: 40rem;
  }

  :global(.contact-details) {
    max-width: 34rem;
  }

  :global(.contact-closing) {
    max-width: 30rem;
  }

  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
  }

  input,
  select,
  textarea {
    background: var(--color-bg-secondary);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    color: var(--color-text-primary);
    font-size: var(--text-body);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-accent-warm);
  }

  textarea {
    resize: vertical;
  }

  .contact-details__list {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-details__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .contact-details__label {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-secondary);
    min-width: 6rem;
  }

  .contact-details__list a {
    font-family: var(--font-sans);
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-details__list a:hover,
  .contact-details__list a:focus-visible {
    color: var(--color-accent-warm);
  }

  @media (max-width: 768px) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
