---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Text from "@/components/Text.astro";
import EditorialLink from "@/components/EditorialLink.astro";
import ScrollReveal from "@/components/ScrollReveal.astro";
import { getPath, type Locale } from "@/i18n/routes";
import { privacyMock } from "@/data/mock/privacy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = privacyMock[locale];

const description =
  locale === "fr"
    ? "Comment Divine Motion traite les renseignements transmis via le site."
    : "How Divine Motion handles information shared through the site.";
---

<BaseLayout locale={locale} pageId="privacy" title={content.title} description={description}>
  <Section spacing="tight">
    <Container class="privacy-hero">
      <div data-reveal>
        <Heading level={1} size="display">{content.title}</Heading>
        <div class="privacy-hero__intro">
          {content.intro.map((paragraph) => (
            <Text as="p" size="lg" tone="secondary">
              {paragraph}
            </Text>
          ))}
        </div>
        <Text as="p" size="small" tone="secondary" class="privacy-hero__updated">
          {content.lastUpdated}
        </Text>
      </div>
    </Container>
  </Section>

  <Section>
    <Container class="privacy-content">
      <div data-reveal>
        {content.sections.map((section) => (
          <div class="privacy-section" id={section.id}>
            <Heading level={2} size="h2">
              {section.title}
            </Heading>
            {section.paragraphs.map((paragraph) => (
              <Text as="p" size="lg">
                {paragraph}
              </Text>
            ))}
            {section.bullets && (
              <ul class="privacy-section__bullets">
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <Section background="secondary">
    <Container class="privacy-content">
      <div data-reveal>
        <Heading level={2} size="h2">
          {content.contactNote.title}
        </Heading>
        <Text as="p" size="lg" class="privacy-contact__text">
          {content.contactNote.text}
        </Text>
        <EditorialLink href={getPath("contact", locale)} class="privacy-contact__link">
          {content.contactNote.linkLabel}
        </EditorialLink>
      </div>
    </Container>
  </Section>
</BaseLayout>

<ScrollReveal />

<style>
  /* :global() — passed to child components (Container, Text, EditorialLink),
     outside this file's own CSS scope. */
  :global(.privacy-hero) {
    max-width: 42rem;
  }

  .privacy-hero__intro {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  :global(.privacy-hero__updated) {
    margin-top: var(--space-8);
  }

  /* Reading column sized in `ch` (character width) rather than rem, per
     Implementation Brief 007 section 6's explicit 60–75 characters/line
     requirement — a precise fit for long-form text at any body size. */
  :global(.privacy-content) {
    max-width: 68ch;
  }

  .privacy-section + .privacy-section {
    margin-top: var(--space-16);
  }

  .privacy-section :global(p) {
    margin-top: var(--space-4);
  }

  .privacy-section__bullets {
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .privacy-section__bullets li {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    border-left: var(--border-width) solid var(--color-border);
  }

  :global(.privacy-contact__text) {
    margin-top: var(--space-4);
  }

  :global(.privacy-contact__link) {
    margin-top: var(--space-6);
  }
</style>
