---
import "@/styles/global.css";
import { getAllPathsFor, type PageId } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  locale: "fr" | "en";
  pageId: PageId;
  title: string;
  description: string;
  /**
   * The homepage's Hero is a full-bleed photograph right below the header
   * (Implementation Brief 002, section 13) — pass true there only. Every
   * other page omits this and keeps the header's current solid style.
   */
  transparentHeaderOverHero?: boolean;
  /**
   * Éditeur visuel Phase 1 — set only by an /admin/site/** editor page
   * (never by a public route) to wrap `<main>` in the one `<form>` the
   * editor's Enregistrer button submits (see EditorToolbar.astro, whose
   * script populates this form with the page's edited fields right
   * before submit). Omitted, `<main>` renders exactly as it always has —
   * zero markup difference for any public request.
   */
  editorFormAction?: string;
}

const {
  locale,
  pageId,
  title,
  description,
  transparentHeaderOverHero = false,
  editorFormAction,
} = Astro.props;
const copy = t(locale);
const paths = getAllPathsFor(pageId);
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const skipLinkLabel = locale === "fr" ? "Aller au contenu" : "Skip to content";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {copy.siteName}</title>
    <meta name="description" content={description} />

    <!-- SEO scaffolding: real per-page OG/Twitter data and structured data
         (Schema.org LocalBusiness/Organization) land with Phase 4/5 content;
         canonical + hreflang are wired now since they depend only on the
         FR/EN route map, not on real content (docs/TECHNICAL_ARCHITECTURE.md). -->
    <link rel="canonical" href={`${siteUrl}${paths[locale]}`} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}${paths.fr}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${paths.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${paths.fr}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLinkLabel}</a>

    <Header locale={locale} pageId={pageId} transparentOverHero={transparentHeaderOverHero} />

    {
      editorFormAction ? (
        <form id="cms-editor-form" data-cms-form method="POST" action={editorFormAction}>
          <main id="main">
            <slot />
          </main>
        </form>
      ) : (
        <main id="main">
          <slot />
        </main>
      )
    }

    <Footer locale={locale} />

    <slot name="admin-chrome" />
  </body>
</html>

<style>
  /*
   * Éditeur visuel Phase 2 — mobile toolbar fix (Boris's staging feedback:
   * "hero overlap"). EditorToolbar.astro's fixed bottom bar sits on top of
   * whatever's at the bottom of the viewport; on mobile, Home's hero CTAs
   * (bottom-aligned, `align-items: flex-end`) land right under it. Only
   * applies when this IS an editor page (`#cms-editor-form` only renders
   * then) — zero effect on any public route.
   */
  @media (max-width: 767px) {
    #cms-editor-form {
      padding-bottom: 3.5rem;
    }
  }
</style>
