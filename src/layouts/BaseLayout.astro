---
import "@/styles/global.css";
import { getAllPathsFor, type PageId } from "@/i18n/routes";
import { t } from "@/i18n/ui";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getDb } from "@/lib/db/client";
import { getPageSeo } from "@/lib/db/seo";
import { getSiteSettings } from "@/lib/db/settings";
import { publicMediaFileUrl } from "@/lib/public-media";

interface Props {
  locale: "fr" | "en";
  pageId: PageId;
  title: string;
  description: string;
  /**
   * The homepage's Hero is a full-bleed photograph right below the header
   * (Implementation Brief 002, section 13) — pass true there only. Every
   * other page omits this and keeps the header's current solid style.
   */
  transparentHeaderOverHero?: boolean;
  /**
   * Éditeur visuel Phase 1 — set only by an /admin/site/** editor page
   * (never by a public route) to render the one `<form>` the editor's
   * Enregistrer button submits (see EditorToolbar.astro, whose script
   * populates this form with the page's edited fields right before
   * submit). Omitted, `<main>` renders exactly as it always has — zero
   * markup difference for any public request.
   *
   * Staging bug fix: this form used to WRAP `<main>`. On Contact, whose
   * public content has its own real `<form class="contact-form">`
   * (Implementation Brief 003 — visual only, never actually submits, but
   * still a real `<form>` element), that nested a `<form>` inside
   * `#cms-editor-form`. HTML forbids nested forms — the browser's parser
   * silently drops the inner `<form>` tag and merges its `required`
   * fields into the OUTER form, so clicking "Enregistrer" triggered the
   * PUBLIC contact form's native validation instead of saving. None of
   * the CMS fields (Editable.astro/EditableImage.astro) are native form
   * controls — they never needed to be physically inside a `<form>` to
   * submit with it — so the form is now a separate, empty sibling of
   * `<main>`, and `<main>` instead carries `data-cms-fields-for` pointing
   * at it (EditorToolbar.astro's script reads fields from there instead
   * of from inside the form).
   */
  editorFormAction?: string;
}

const {
  locale,
  pageId,
  title,
  description,
  transparentHeaderOverHero = false,
  editorFormAction,
} = Astro.props;
const copy = t(locale);
const paths = getAllPathsFor(pageId);
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const skipLinkLabel = locale === "fr" ? "Aller au contenu" : "Skip to content";

// D1 SEO is deliberately fail-soft: editorial pages must keep rendering
// with their component-provided title/description if D1 is temporarily
// unavailable or a seed row is missing.
let seoTitle = title;
let seoDescription = description;
let canonicalUrl = `${siteUrl}${paths[locale]}`;
let ogImageUrl: string | null = null;
let noindex = false;
let brandName: string = copy.siteName;
let serviceArea: string | null = null;
try {
  const db = getDb();
  const [seo, settings] = await Promise.all([getPageSeo(db, pageId), getSiteSettings(db)]);
  if (seo) {
    seoTitle = locale === "fr" ? seo.title_fr : seo.title_en;
    seoDescription = locale === "fr" ? seo.description_fr : seo.description_en;
    canonicalUrl = seo.canonical_override || canonicalUrl;
    ogImageUrl = seo.og_media_id ? `${siteUrl}${publicMediaFileUrl(seo.og_media_id)}` : null;
    noindex = seo.noindex === 1;
  }
  if (settings) {
    brandName = settings.brand_name;
    serviceArea = locale === "fr" ? settings.service_area_fr : settings.service_area_en;
  }
} catch (err) {
  console.error("BaseLayout: SEO D1 read failed", err instanceof Error ? err.message : err);
}

const fullTitle = seoTitle.includes(brandName) ? seoTitle : `${seoTitle} — ${brandName}`;
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: brandName,
  url: `${siteUrl}${paths[locale]}`,
  description: seoDescription,
  ...(serviceArea ? { areaServed: serviceArea } : {}),
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
});
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={seoDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- SEO MVP: D1-backed bilingual metadata with component fallbacks,
         canonical/hreflang, social cards and structured data. -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="fr" href={`${siteUrl}${paths.fr}`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${paths.en}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${paths.fr}`} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === "fr" ? "fr_CA" : "en_CA"} />
    <meta property="og:locale:alternate" content={locale === "fr" ? "en_CA" : "fr_CA"} />
    <meta property="og:site_name" content={brandName} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={seoDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <script is:inline type="application/ld+json" set:html={structuredData} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLinkLabel}</a>

    <Header locale={locale} pageId={pageId} transparentOverHero={transparentHeaderOverHero} />

    {
      editorFormAction ? (
        <>
          <main id="main" data-cms-fields-for="cms-editor-form">
            <slot />
          </main>
          <form id="cms-editor-form" data-cms-form method="POST" action={editorFormAction} />
        </>
      ) : (
        <main id="main">
          <slot />
        </main>
      )
    }

    <Footer locale={locale} />

    <slot name="admin-chrome" />
  </body>
</html>

<style>
  /*
   * Éditeur visuel Phase 2 — mobile toolbar fix (Boris's staging feedback:
   * "hero overlap"). EditorToolbar.astro's fixed bottom bar sits on top of
   * whatever's at the bottom of the viewport; on mobile, Home's hero CTAs
   * (bottom-aligned, `align-items: flex-end`) land right under it. Targets
   * `#main` (was `#cms-editor-form` before that stopped wrapping `<main>`
   * — see this component's `editorFormAction` doc) — `[data-cms-fields-for]`
   * only renders on an editor page, so this has zero effect on any public
   * route.
   */
  @media (max-width: 767px) {
    #main[data-cms-fields-for] {
      padding-bottom: 3.5rem;
    }
  }
</style>
