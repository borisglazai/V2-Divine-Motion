---
/**
 * Éditeur visuel Phase 2 — "Modifier le site" for Travail: page-level copy
 * (title/intro/CTA/gallery_layout — src/lib/admin/work-page-editor-actions.ts)
 * AND the real, in-place gallery slot editor
 * (src/components/admin/GallerySlot.astro, via TravailGalleryEditor.astro).
 * Same pattern as ../services.astro (Accueil/Services) for the page-level
 * chrome — the gallery itself is new this phase, see WorkView.astro.
 */
export const prerender = false;
import WorkView from "@/components/pages/WorkView.astro";
import EditorToolbar from "@/components/admin/EditorToolbar.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import * as pages from "@/lib/db/pages";
import * as media from "@/lib/db/media";
import { getDb } from "@/lib/db/client";
import { readFlash } from "@/lib/admin/flash";
import type { Locale } from "@/i18n/routes";

const localeParam = Astro.url.searchParams.get("lang");
const locale: Locale = localeParam === "en" ? "en" : "fr";
const mode = Astro.url.searchParams.get("mode") === "preview" ? "preview" : "edit";
const flash = readFlash(Astro.url);

const db = getDb();
const draft = await pages.workPageContent.getDraft(db);
const published = await pages.workPageContent.getPublished(db);
const readyMedia = media.sortMediaForPicker((await media.listMedia(db)).filter((m) => m.processing_status === "ready"));
---

<WorkView locale={locale} mode={mode} saveAction="/admin/site/travail/save">
  <Fragment slot="admin-chrome">
    <div class="cms-flash-overlay">
      <FlashMessage flash={flash} />
    </div>
    <EditorToolbar
      activePageId="travail"
      locale={locale}
      mode={mode}
      available={true}
      publishAction="/admin/site/travail/publish"
      languageStatusAction="/admin/site/travail/language-status"
      hasDraft={draft !== null}
      frStatus={published?.fr_status}
      enStatus={published?.en_status}
      media={readyMedia}
      galleryLayout={(draft ?? published)?.gallery_layout ?? "editorial"}
    />
  </Fragment>
</WorkView>

<style>
  .cms-flash-overlay {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: min(32rem, 90vw);
  }

  .cms-flash-overlay :global(.flash-message) {
    background: var(--color-bg-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
</style>
