---
/**
 * Éditeur visuel Phase 1 — "Modifier le site" for the Services page-level
 * copy (title/intro/approach label/final CTA). Same pattern as
 * ../site.astro (Accueil) — see that file's header comment. Never
 * touches the individual services items (their own, already-validated
 * CMS at /admin/services).
 */
export const prerender = false;
import ServicesView from "@/components/pages/ServicesView.astro";
import EditorToolbar from "@/components/admin/EditorToolbar.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import * as pages from "@/lib/db/pages";
import { getDb } from "@/lib/db/client";
import { readFlash } from "@/lib/admin/flash";
import type { Locale } from "@/i18n/routes";

const localeParam = Astro.url.searchParams.get("lang");
const locale: Locale = localeParam === "en" ? "en" : "fr";
const mode = Astro.url.searchParams.get("mode") === "preview" ? "preview" : "edit";
const flash = readFlash(Astro.url);

const db = getDb();
const draft = await pages.servicesPageContent.getDraft(db);
const published = await pages.servicesPageContent.getPublished(db);
---

<ServicesView locale={locale} mode={mode} saveAction="/admin/site/services/save">
  <Fragment slot="admin-chrome">
    <div class="cms-flash-overlay">
      <FlashMessage flash={flash} />
    </div>
    <EditorToolbar
      activePageId="services"
      locale={locale}
      mode={mode}
      available={true}
      publishAction="/admin/site/services/publish"
      languageStatusAction="/admin/site/services/language-status"
      hasDraft={draft !== null}
      frStatus={published?.fr_status}
      enStatus={published?.en_status}
    />
  </Fragment>
</ServicesView>

<style>
  .cms-flash-overlay {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: min(32rem, 90vw);
  }

  .cms-flash-overlay :global(.flash-message) {
    background: var(--color-bg-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
</style>
