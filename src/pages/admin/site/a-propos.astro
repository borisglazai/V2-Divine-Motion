---
/**
 * Éditeur visuel Phase 2 — "Modifier le site" for À propos (`about_content`
 * + its 2 child tables). Same pattern as ../services.astro.
 */
export const prerender = false;
import AboutView from "@/components/pages/AboutView.astro";
import EditorToolbar from "@/components/admin/EditorToolbar.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import * as pages from "@/lib/db/pages";
import * as media from "@/lib/db/media";
import { getDb } from "@/lib/db/client";
import { readFlash } from "@/lib/admin/flash";
import type { Locale } from "@/i18n/routes";

const localeParam = Astro.url.searchParams.get("lang");
const locale: Locale = localeParam === "en" ? "en" : "fr";
const mode = Astro.url.searchParams.get("mode") === "preview" ? "preview" : "edit";
const flash = readFlash(Astro.url);

const db = getDb();
const draft = await pages.aboutContent.getDraft(db);
const published = await pages.aboutContent.getPublished(db);
const readyMedia = media.sortMediaForPicker((await media.listMedia(db)).filter((m) => m.processing_status === "ready"));
---

<AboutView locale={locale} mode={mode} saveAction="/admin/site/a-propos/save">
  <Fragment slot="admin-chrome">
    <div class="cms-flash-overlay">
      <FlashMessage flash={flash} />
    </div>
    <EditorToolbar
      activePageId="about"
      locale={locale}
      mode={mode}
      available={true}
      publishAction="/admin/site/a-propos/publish"
      languageStatusAction="/admin/site/a-propos/language-status"
      hasDraft={draft !== null}
      frStatus={published?.fr_status}
      enStatus={published?.en_status}
      media={readyMedia}
    />
  </Fragment>
</AboutView>

<style>
  .cms-flash-overlay {
    position: fixed;
    top: var(--space-4);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: min(32rem, 90vw);
  }

  .cms-flash-overlay :global(.flash-message) {
    background: var(--color-bg-primary);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
  }
</style>
