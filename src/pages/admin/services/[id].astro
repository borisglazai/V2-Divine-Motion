---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import ServiceForm from "@/components/admin/ServiceForm.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import { getDb } from "@/lib/db/client";
import * as media from "@/lib/db/media";
import * as services from "@/lib/db/services";
import { readFlash } from "@/lib/admin/flash";
import { readFormRedirect } from "@/lib/admin/formRedirect";

const identity = Astro.locals.adminIdentity!;
const idParam = Number(Astro.params.id);

if (!Number.isInteger(idParam) || idParam <= 0) {
  return new Response("Not found.", { status: 404 });
}

const db = getDb();
const row = await services.getService(db, idParam);
if (!row) {
  return new Response("Not found.", { status: 404 });
}

const draft = row.status === "draft" ? row : await services.getServiceDraft(db, row.id);
const publishedRow = row.status === "published" ? row : row.draft_of_id ? await services.getService(db, row.draft_of_id) : null;
const formSource = draft ?? publishedRow ?? row;

const readyMedia = media.sortMediaForPicker(
  (await media.listMedia(db)).filter((m) => m.processing_status === "ready"),
);
const flash = readFlash(Astro.url);
// Note: a validation-failure redisplay carries every scalar field back
// via readFormRedirect, but not the "points forts"/highlights list
// (formData.getAll(...) is a repeated field, not a single value —
// buildFormRedirect only round-trips single values). On that one path
// the highlights fall back to formSource's saved values below rather
// than what was just typed — an accepted, narrow gap, not a silent data
// loss (nothing is ever written to D1 on a validation failure).
const { errors } = readFormRedirect(Astro.url);
---

<AdminLayout activeId="services" title={`Service #${idParam}`} identity={identity}>
  <FlashMessage flash={flash} />

  <p class="edit-service__note">
    {draft
      ? "Modification du brouillon — le site public n'est pas affecté tant que vous ne publiez pas explicitement."
      : "Aucun brouillon ouvert : enregistrer ci-dessous en créera un automatiquement, sans rien publier."}
  </p>

  {errors.form && (
    <p class="edit-service__form-error" role="alert">
      {errors.form}
    </p>
  )}

  <ServiceForm
    action={`/admin/services/${idParam}/save`}
    submitLabel="Enregistrer le brouillon"
    media={readyMedia}
    errors={errors}
    features={formSource.features}
    values={{
      mediaId: formSource.media_id,
      slug: formSource.slug,
      position: formSource.position,
      ratio: formSource.ratio,
      titleFr: formSource.title_fr,
      titleEn: formSource.title_en,
      taglineFr: formSource.tagline_fr,
      taglineEn: formSource.tagline_en,
      descriptionFr: formSource.description_fr,
      descriptionEn: formSource.description_en,
      imageAltFr: formSource.image_alt_fr,
      imageAltEn: formSource.image_alt_en,
      ctaLabelFr: formSource.cta_label_fr,
      ctaLabelEn: formSource.cta_label_en,
      isActive: formSource.is_active === 1,
    }}
  />

  <div class="edit-service__side-actions">
    {draft && (
      <form method="POST" action={`/admin/services/${draft.id}/publish`}>
        <button type="submit">Publier</button>
      </form>
    )}
    {draft && (
      <form method="POST" action={`/admin/services/${draft.id}/delete-draft`}>
        <button type="submit" class="edit-service__danger">
          Supprimer le brouillon
        </button>
      </form>
    )}
  </div>

  {publishedRow && (
    <section class="language-status" aria-labelledby="language-status-heading">
      <h2 id="language-status-heading">Publication par langue</h2>
      <p class="language-status__note">
        Publier le contenu d'un brouillon et publier une langue sont deux actions distinctes — voir ci-dessus pour le
        contenu, ci-dessous pour la visibilité FR/EN de la version déjà publiée.
      </p>
      <div class="language-status__grid">
        <div class="language-status__lang">
          <p>FR : <strong>{publishedRow.fr_status === "published" ? "Publié" : "Brouillon"}</strong></p>
          <form method="POST" action={`/admin/services/${publishedRow.id}/language-status`}>
            <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="status" value="published" />
            <button type="submit" disabled={publishedRow.fr_status === "published"}>
              Publier FR
            </button>
          </form>
          <form method="POST" action={`/admin/services/${publishedRow.id}/language-status`}>
            <input type="hidden" name="locale" value="fr" />
            <input type="hidden" name="status" value="draft" />
            <button type="submit" disabled={publishedRow.fr_status !== "published"}>
              Repasser FR en brouillon
            </button>
          </form>
        </div>
        <div class="language-status__lang">
          <p>EN : <strong>{publishedRow.en_status === "published" ? "Publié" : "Brouillon"}</strong></p>
          <form method="POST" action={`/admin/services/${publishedRow.id}/language-status`}>
            <input type="hidden" name="locale" value="en" />
            <input type="hidden" name="status" value="published" />
            <button type="submit" disabled={publishedRow.en_status === "published"}>
              Publier EN
            </button>
          </form>
          <form method="POST" action={`/admin/services/${publishedRow.id}/language-status`}>
            <input type="hidden" name="locale" value="en" />
            <input type="hidden" name="status" value="draft" />
            <button type="submit" disabled={publishedRow.en_status !== "published"}>
              Repasser EN en brouillon
            </button>
          </form>
        </div>
      </div>
    </section>
  )}
</AdminLayout>

<style>
  .edit-service__note {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    margin-bottom: var(--space-6);
    max-width: 40rem;
  }

  .edit-service__form-error {
    color: #e08a80;
    padding: var(--space-4);
    border: var(--border-width) solid #c2554b;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
  }

  .edit-service__side-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .edit-service__side-actions button {
    font-size: var(--text-small);
    color: var(--color-text-primary);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    min-height: 2.75rem;
  }

  .edit-service__danger {
    color: #e08a80;
  }

  .language-status {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--color-border);
  }

  .language-status h2 {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .language-status__note {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    max-width: 40rem;
    margin-bottom: var(--space-6);
  }

  .language-status__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-6);
  }

  .language-status__lang {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-primary);
  }

  .language-status__lang form {
    display: inline-block;
  }

  .language-status__lang button {
    font-size: var(--text-small);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    cursor: pointer;
    min-height: 2.5rem;
  }

  .language-status__lang button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
