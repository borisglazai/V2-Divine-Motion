---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import { getDb } from "@/lib/db/client";
import { getSiteSettings } from "@/lib/db/settings";
import { readFlash } from "@/lib/admin/flash";
import type { SiteSettingsRow } from "@/lib/db/types";

const identity = Astro.locals.adminIdentity!;
const flash = readFlash(Astro.url);
let settings: SiteSettingsRow | null = null;
let dbUnavailable = false;
try {
  settings = await getSiteSettings(getDb());
} catch (err) {
  console.error("admin settings: D1 read failed", err instanceof Error ? err.message : err);
  dbUnavailable = true;
}
---

<AdminLayout activeId="settings" title="Paramètres" identity={identity}>
  <FlashMessage flash={flash} />
  <p class="settings-intro">Coordonnées et valeurs globales utilisées par le site public. Les changements sont appliqués immédiatement.</p>
  {dbUnavailable || !settings ? <p role="alert">Les paramètres ne sont pas disponibles pour le moment.</p> : (
    <form method="POST" action="/admin/settings/save" class="settings-form">
      <section>
        <h2>Identité et contact</h2>
        <div class="settings-grid">
          <label>Nom de marque <input name="brandName" value={settings.brand_name} required maxlength="80" /></label>
          <label>Courriel public <input type="email" name="contactEmail" value={settings.contact_email} required /></label>
          <label>URL Instagram <input type="url" name="instagramUrl" value={settings.instagram_url} required /></label>
          <label>Libellé Instagram <input name="instagramHandleLabel" value={settings.instagram_handle_label} required maxlength="50" /></label>
          <label>Zone desservie — FR <input name="serviceAreaFr" value={settings.service_area_fr ?? ""} /></label>
          <label>Service area — EN <input name="serviceAreaEn" value={settings.service_area_en ?? ""} /></label>
        </div>
      </section>
      <section>
        <h2>SEO par défaut</h2>
        <p class="settings-note">Utilisé comme référence globale. Les réglages par page se modifient dans <a href="/admin/seo">SEO</a>.</p>
        <div class="settings-grid">
          <label>Titre par défaut — FR <input name="defaultSeoTitleFr" value={settings.default_seo_title_fr} required maxlength="70" /></label>
          <label>Default title — EN <input name="defaultSeoTitleEn" value={settings.default_seo_title_en} required maxlength="70" /></label>
          <label>Description par défaut — FR <textarea name="defaultSeoDescriptionFr" required maxlength="180">{settings.default_seo_description_fr}</textarea></label>
          <label>Default description — EN <textarea name="defaultSeoDescriptionEn" required maxlength="180">{settings.default_seo_description_en}</textarea></label>
        </div>
      </section>
      <button class="admin-btn admin-btn--primary" type="submit">Enregistrer les paramètres</button>
    </form>
  )}
</AdminLayout>

<style>
  .settings-intro, .settings-note { color: var(--color-text-secondary); max-width: 48rem; }
  .settings-form { display: grid; gap: var(--space-8); max-width: 64rem; }
  .settings-form section { display: grid; gap: var(--space-4); padding: var(--space-5); background: var(--color-surface-admin); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-md); }
  .settings-form h2 { font-family: var(--font-serif); font-size: var(--text-h3); }
  .settings-grid { display: grid; gap: var(--space-4); }
  label { display: grid; gap: var(--space-2); color: var(--color-text-secondary); font-size: var(--text-small); }
  input, textarea { width: 100%; color: var(--color-text-primary); background: var(--color-bg-primary); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-sm); padding: var(--space-3); font: inherit; }
  textarea { min-height: 6rem; resize: vertical; }
  button { justify-self: start; }
  @media (min-width: 800px) { .settings-grid { grid-template-columns: 1fr 1fr; } }
</style>
