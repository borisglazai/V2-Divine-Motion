---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import FlashMessage from "@/components/admin/FlashMessage.astro";
import ImageFrame from "@/components/ImageFrame.astro";
import { getDb } from "@/lib/db/client";
import * as work from "@/lib/db/work";
import { readFlash } from "@/lib/admin/flash";
import type { WorkItemRow } from "@/lib/db/types";

const identity = Astro.locals.adminIdentity!;
const flash = readFlash(Astro.url);

let publishedItems: WorkItemRow[] = [];
let draftByPublishedId = new Map<number, WorkItemRow>();
let newDrafts: WorkItemRow[] = [];
let dbUnavailable = false;

try {
  const all = await work.listAllWorkItems(getDb());
  publishedItems = all.filter((r) => r.status === "published").sort((a, b) => a.position - b.position);
  const drafts = all.filter((r) => r.status === "draft");
  draftByPublishedId = new Map(
    drafts.filter((d): d is WorkItemRow & { draft_of_id: number } => d.draft_of_id !== null).map((d) => [d.draft_of_id, d]),
  );
  newDrafts = drafts.filter((d) => d.draft_of_id === null);
} catch (err) {
  console.error("admin work list: D1 read failed", err instanceof Error ? err.message : err);
  dbUnavailable = true;
}

const orderedPublishedIds = publishedItems.map((r) => r.id);

function orderWithSwap(ids: number[], index: number, direction: -1 | 1): string {
  const target = index + direction;
  if (target < 0 || target >= ids.length) return JSON.stringify(ids);
  const next = [...ids];
  [next[index], next[target]] = [next[target], next[index]];
  return JSON.stringify(next);
}
---

<AdminLayout activeId="work" title="Travail" identity={identity}>
  <FlashMessage flash={flash} />

  {
    dbUnavailable ? (
      <p class="admin-db-error" role="alert">
        Les données ne sont pas disponibles pour le moment. Réessayez dans un instant.
      </p>
    ) : (
      <>
        <div class="work-list__header">
          <p class="work-list__note">
            Le réordonnancement ne modifie que les brouillons — l'ordre public ne change qu'après une publication
            explicite de chaque élément déplacé (voir <a href="/admin/work/new">créer un nouvel élément</a>).
          </p>
          <a class="work-list__new-button" href="/admin/work/new">
            + Nouvel élément
          </a>
        </div>

        <ul class="work-list">
          {publishedItems.map((item, index) => {
            const draft = draftByPublishedId.get(item.id);
            return (
              <li class="work-card">
                <ImageFrame src="/mock/placeholder.svg" alt="" ratio={item.ratio} class="work-card__thumb" />
                <div class="work-card__body">
                  <p class="work-card__title">
                    #{item.id} — position {item.position} {item.category ? `· ${item.category}` : ""}
                  </p>
                  <p class="work-card__status">
                    FR : <strong>{item.fr_status}</strong> · EN : <strong>{item.en_status}</strong> ·{" "}
                    {item.is_visible ? "visible" : "masqué"} · {item.featured_on_home ? "en avant sur l'accueil" : "—"}
                  </p>
                  <p class="work-card__draft-state">{draft ? "Brouillon en attente de publication" : "Aucun brouillon ouvert"}</p>

                  <div class="work-card__actions">
                    <a href={`/admin/work/${item.id}`}>Modifier</a>
                    <a href={`/admin/work/${item.id}/preview`}>Prévisualiser</a>
                    {draft && (
                      <form method="POST" action={`/admin/work/${draft.id}/publish`}>
                        <button type="submit">Publier</button>
                      </form>
                    )}
                    {draft && (
                      <form method="POST" action={`/admin/work/${draft.id}/delete-draft`}>
                        <button type="submit" class="work-card__danger">
                          Supprimer le brouillon
                        </button>
                      </form>
                    )}
                  </div>

                  <div class="work-card__reorder" role="group" aria-label={`Réordonner l'élément #${item.id}`}>
                    <form method="POST" action="/admin/work/reorder">
                      <input type="hidden" name="orderedIds" value={orderWithSwap(orderedPublishedIds, index, -1)} />
                      <button type="submit" disabled={index === 0} aria-label="Monter">
                        ▲ Monter
                      </button>
                    </form>
                    <form method="POST" action="/admin/work/reorder">
                      <input
                        type="hidden"
                        name="orderedIds"
                        value={orderWithSwap(orderedPublishedIds, index, 1)}
                      />
                      <button type="submit" disabled={index === publishedItems.length - 1} aria-label="Descendre">
                        ▼ Descendre
                      </button>
                    </form>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>

        {newDrafts.length > 0 && (
          <>
            <h2 class="work-list__section-title">Brouillons non publiés</h2>
            <ul class="work-list">
              {newDrafts.map((draft) => (
                <li class="work-card">
                  <ImageFrame src="/mock/placeholder.svg" alt="" ratio={draft.ratio} class="work-card__thumb" />
                  <div class="work-card__body">
                    <p class="work-card__title">Brouillon #{draft.id} — jamais publié</p>
                    <div class="work-card__actions">
                      <a href={`/admin/work/${draft.id}`}>Modifier</a>
                      <a href={`/admin/work/${draft.id}/preview`}>Prévisualiser</a>
                      <form method="POST" action={`/admin/work/${draft.id}/publish`}>
                        <button type="submit">Publier</button>
                      </form>
                      <form method="POST" action={`/admin/work/${draft.id}/delete-draft`}>
                        <button type="submit" class="work-card__danger">
                          Supprimer le brouillon
                        </button>
                      </form>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </>
        )}
      </>
    )
  }
</AdminLayout>

<style>
  .admin-db-error {
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
  }

  .work-list__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .work-list__note {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    max-width: 40rem;
  }

  .work-list__new-button {
    background: var(--color-accent-warm);
    color: var(--color-bg-primary);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-5);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .work-list__section-title {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-text-primary);
    margin-block: var(--space-8) var(--space-4);
  }

  .work-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .work-card {
    display: flex;
    gap: var(--space-4);
    background: var(--color-surface-admin);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .work-card__thumb {
    width: 5rem;
    flex-shrink: 0;
  }

  .work-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .work-card__title {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .work-card__status,
  .work-card__draft-state {
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .work-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .work-card__actions a,
  .work-card__actions button {
    font-size: var(--text-small);
    color: var(--color-text-primary);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    min-height: 2.5rem;
    text-decoration: none;
  }

  .work-card__danger {
    color: #e08a80;
  }

  .work-card__reorder {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .work-card__reorder button {
    font-size: var(--text-small);
    background: none;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    cursor: pointer;
    min-height: 2.5rem;
  }

  .work-card__reorder button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  @media (min-width: 768px) {
    .work-card {
      align-items: center;
    }
  }
</style>
